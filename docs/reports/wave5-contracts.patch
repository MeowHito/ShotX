+    expect(
+      createCheckoutBodySchema.safeParse({
+        planCode: 'pro',
+        changeType: 'new',
+        payment: { method: 'card', months: 3 },
+      }).success,
+    ).toBe(false);
+    expect(
+      createCheckoutBodySchema.safeParse({
