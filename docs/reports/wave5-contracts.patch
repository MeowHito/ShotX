diff --git a/packages/shared/src/billing/email.ts b/packages/shared/src/billing/email.ts
new file mode 100644
index 0000000..bc87dba
--- /dev/null
+++ b/packages/shared/src/billing/email.ts
@@ -0,0 +1,94 @@
+import { z } from 'zod';
+import { CHECKOUT_CHANGE_TYPES, PAYMENT_METHODS } from '../domain';
+import { satangSchema } from './money';
+
+/**
+ * The email adapter. Types only: `SesEmailProvider` (placeholder until SES is set up) and
+ * `FakeEmailProvider` (records messages, for tests and local runs) live in the api and worker,
+ * selected by EMAIL_PROVIDER (loadEmailConfig). Shared defines the templates, their i18n keys and
+ * their parameters; the Thai subject and body text live in the api/worker messages (`th`), keyed
+ * by EMAIL_TEMPLATES[template].subjectKey / bodyKey, so every template must have both strings.
+ * Amounts are satang (render as THB with 2 decimals), times are ISO 8601 (render in Asia/Bangkok).
+ * Parameters never contain card data, biometrics or anything about viewers.
+ */
+
+const isoDateTime = z.iso.datetime({ offset: true });
+const url = z.url();
+
+export const EMAIL_TEMPLATE_PARAMS = {
+  /** T-14/T-7/T-1 before period_end (dueRenewalReminder). */
+  renewal_reminder: z.strictObject({
+    planName: z.string().min(1),
+    periodEnd: isoDateTime,
+    daysBefore: z.number().int().positive(),
+    /** True: "your card will be charged"; false: "renew to keep uploading". */
+    autoRenew: z.boolean(),
+    /** The auto-renew charge; null for prepaid. */
+    renewalAmountSatang: satangSchema.nullable(),
+    billingUrl: url,
+  }),
+  /** After a payment is applied (logged by payments.receipt_sent_at). Not a full tax invoice. */
+  payment_receipt: z.strictObject({
+    paymentId: z.uuid(),
+    planName: z.string().min(1),
+    changeType: z.enum(CHECKOUT_CHANGE_TYPES).nullable(),
+    method: z.enum(PAYMENT_METHODS),
+    totalSatang: satangSchema,
+    vatSatang: satangSchema,
+    netSatang: satangSchema,
+    paidAt: isoDateTime,
+    periodEnd: isoDateTime,
+    billingUrl: url,
+  }),
+  /** The period ended: uploads blocked, shares still work until graceEndsAt. */
+  grace_started: z.strictObject({ graceEndsAt: isoDateTime, billingUrl: url }),
+  /** Grace is over: shares show "ลิงก์นี้หมดอายุ"; files are deleted at purgeAt. */
+  subscription_expired: z.strictObject({ purgeAt: isoDateTime, billingUrl: url }),
+  /** SUBSCRIPTION_PURGE_WARNING_DAYS before the purge. */
+  purge_warning: z.strictObject({ purgeAt: isoDateTime, billingUrl: url }),
+} as const;
+
+export type EmailTemplate = keyof typeof EMAIL_TEMPLATE_PARAMS;
+export const EMAIL_TEMPLATE_NAMES = Object.keys(EMAIL_TEMPLATE_PARAMS) as readonly EmailTemplate[];
+export type EmailTemplateParams<T extends EmailTemplate> = z.input<
+  (typeof EMAIL_TEMPLATE_PARAMS)[T]
+>;
+
+/** i18n keys of each template's Thai subject and body (the text lives in the api/worker). */
+export const EMAIL_TEMPLATES = {
+  renewal_reminder: {
+    subjectKey: 'email.renewalReminder.subject',
+    bodyKey: 'email.renewalReminder.body',
+  },
+  payment_receipt: {
+    subjectKey: 'email.paymentReceipt.subject',
+    bodyKey: 'email.paymentReceipt.body',
+  },
+  grace_started: { subjectKey: 'email.graceStarted.subject', bodyKey: 'email.graceStarted.body' },
+  subscription_expired: {
+    subjectKey: 'email.subscriptionExpired.subject',
+    bodyKey: 'email.subscriptionExpired.body',
+  },
+  purge_warning: { subjectKey: 'email.purgeWarning.subject', bodyKey: 'email.purgeWarning.body' },
+} as const satisfies Record<EmailTemplate, { subjectKey: string; bodyKey: string }>;
+
+/** One email to send. The provider renders `template` with `params` in `locale`. */
+export interface EmailMessage<T extends EmailTemplate = EmailTemplate> {
+  to: string;
+  template: T;
+  locale: 'th';
+  params: EmailTemplateParams<T>;
+  /**
+   * Stable per logical email (e.g. `notice:{subscriptionId}:{kind}:{periodEnd}:{days}` or
+   * `receipt:{paymentId}`); providers that support it dedupe on it.
+   */
+  idempotencyKey: string;
+}
+
+export interface EmailProvider {
+  /** Sends one message. Throws on failure; the caller logs the notice only after success. */
+  send<T extends EmailTemplate>(message: EmailMessage<T>): Promise<{ messageId: string }>;
+}
+
+/** Path of the studio billing page that emails link to (PUBLIC_BASE_URL + this). */
+export const BILLING_PAGE_PATH = '/studio/billing';
diff --git a/packages/shared/src/billing/fake-gateway.ts b/packages/shared/src/billing/fake-gateway.ts
new file mode 100644
index 0000000..34958ea
--- /dev/null
+++ b/packages/shared/src/billing/fake-gateway.ts
@@ -0,0 +1,97 @@
+import { z } from 'zod';
+import { PAYMENT_EVENT_TYPES } from '../domain';
+import { satangSchema } from './money';
+
+/**
+ * The `fake` gateway's webhook signature, for development and tests (production refuses the fake
+ * gateway). Header {@link FAKE_WEBHOOK_SIGNATURE_HEADER}:
+ *
+ *   t=<unix seconds>,v1=<lowercase hex HMAC-SHA256(PAYMENT_FAKE_WEBHOOK_SECRET, "<t>.<raw body>")>
+ *
+ * The body is UTF-8 JSON of {@link fakeWebhookBodySchema}. A signature older or newer than
+ * PAYMENT_WEBHOOK_TOLERANCE_SECONDS is rejected (replay protection). Same scheme as Stripe's, so
+ * the real adapters' verification paths look alike.
+ */
+export const FAKE_WEBHOOK_SIGNATURE_HEADER = 'x-fake-signature';
+
+export const fakeWebhookBodySchema = z.strictObject({
+  /** Unique per event; the fake gateway's event id. */
+  id: z.string().min(1).max(255),
+  /** The charge (`payments.gateway_ref`). */
+  chargeId: z.string().min(1).max(255),
+  type: z.enum(PAYMENT_EVENT_TYPES),
+  amountSatang: satangSchema,
+  currency: z.literal('THB'),
+  occurredAt: z.iso.datetime({ offset: true }),
+  /** The saved card on a paid card charge. */
+  paymentMethodRef: z.string().min(1).max(255).nullable().default(null),
+  failureCode: z.string().min(1).max(64).nullable().default(null),
+});
+export type FakeWebhookBody = z.input<typeof fakeWebhookBodySchema>;
+
+const encoder = new TextEncoder();
+
+function toHex(bytes: ArrayBuffer): string {
+  return [...new Uint8Array(bytes)].map((b) => b.toString(16).padStart(2, '0')).join('');
+}
+
+function concat(a: Uint8Array, b: Uint8Array): Uint8Array<ArrayBuffer> {
+  const out = new Uint8Array(a.length + b.length);
+  out.set(a, 0);
+  out.set(b, a.length);
+  return out;
+}
+
+/** Lowercase hex HMAC-SHA256 of `"<timestamp>.<rawBody>"` (Web Crypto: Node and browsers). */
+export async function fakeWebhookSignature(
+  secret: string,
+  timestampSeconds: number,
+  rawBody: Uint8Array,
+): Promise<string> {
+  const key = await globalThis.crypto.subtle.importKey(
+    'raw',
+    encoder.encode(secret),
+    { name: 'HMAC', hash: 'SHA-256' },
+    false,
+    ['sign'],
+  );
+  const signed = concat(encoder.encode(`${timestampSeconds}.`), rawBody);
+  return toHex(await globalThis.crypto.subtle.sign('HMAC', key, signed));
+}
+
+/** The header value for a body signed at `timestampSeconds` (tests and the local fake gateway). */
+export async function fakeWebhookSignatureHeader(
+  secret: string,
+  timestampSeconds: number,
+  rawBody: Uint8Array,
+): Promise<string> {
+  return `t=${timestampSeconds},v1=${await fakeWebhookSignature(secret, timestampSeconds, rawBody)}`;
+}
+
+const HEADER = /^t=(\d{1,12}),v1=([0-9a-f]{64})$/;
+
+function constantTimeEqual(a: string, b: string): boolean {
+  if (a.length !== b.length) return false;
+  let diff = 0;
+  for (let i = 0; i < a.length; i++) diff |= a.charCodeAt(i) ^ b.charCodeAt(i);
+  return diff === 0;
+}
+
+/**
+ * True when `header` is a valid signature of `rawBody` with `secret`, made within
+ * `toleranceSeconds` of `now`. Malformed headers are false, never an exception.
+ */
+export async function verifyFakeWebhookSignature(input: {
+  header: string | undefined;
+  rawBody: Uint8Array;
+  secret: string;
+  now: Date;
+  toleranceSeconds: number;
+}): Promise<boolean> {
+  const match = HEADER.exec(input.header ?? '');
+  if (match === null) return false;
+  const timestamp = Number(match[1]);
+  if (Math.abs(input.now.getTime() / 1000 - timestamp) > input.toleranceSeconds) return false;
+  const expected = await fakeWebhookSignature(input.secret, timestamp, input.rawBody);
+  return constantTimeEqual(expected, match[2] ?? '');
+}
diff --git a/packages/shared/src/billing/gateway.ts b/packages/shared/src/billing/gateway.ts
new file mode 100644
index 0000000..bf652b9
--- /dev/null
+++ b/packages/shared/src/billing/gateway.ts
@@ -0,0 +1,127 @@
+import { z } from 'zod';
+import { PAYMENT_EVENT_TYPES, PAYMENT_GATEWAYS, type PaymentGateway } from '../domain';
+import { satangSchema } from './money';
+
+/**
+ * The payment gateway adapter. Types only: implementations (`FakePaymentGateway`, and later
+ * `OmisePaymentGateway`, `TwoC2PPaymentGateway`) live in apps/api, selected by PAYMENT_GATEWAY
+ * (loadPaymentGatewayConfig). Card data never reaches the platform: cards are entered on the
+ * gateway's page (or its JS tokenizer) and only the gateway's reference to the saved method is
+ * stored (`subscriptions.payment_method_ref`).
+ */
+export interface PaymentGatewayAdapter {
+  readonly name: PaymentGateway;
+  /**
+   * Starts collecting `amountSatang`: a PromptPay QR (prepaid periods) or a card page that also
+   * saves the card for auto-renew. Idempotent by `idempotencyKey` (the checkout id), so a retry
+   * returns the same charge.
+   */
+  createCheckout(input: CreateCheckoutInput): Promise<CreateCheckoutResult>;
+  /**
+   * Charges a saved method off-session (auto-renew, daily job). Idempotent by `idempotencyKey`
+   * (`renewal:{subscriptionId}:{periodEnd ISO}:{attempt}`). The result is usually `pending`; the
+   * webhook decides.
+   */
+  chargeSavedMethod(input: ChargeSavedMethodInput): Promise<ChargeSavedMethodResult>;
+  /**
+   * Checks the webhook's signature over the exact raw body bytes. Never parses before verifying.
+   * False for a missing, malformed, wrong or stale signature (WEBHOOK_SIGNATURE_INVALID).
+   */
+  verifyWebhook(request: RawWebhookRequest): Promise<boolean>;
+  /**
+   * The verified body as one normalized event. Throws for a body it can't read (the API answers
+   * 2xx anyway after storing the hash, so the gateway doesn't retry a body that will never parse,
+   * and alerts). Returns null for event kinds the platform ignores (also 2xx).
+   */
+  parseWebhookEvent(request: RawWebhookRequest): NormalizedPaymentEvent | null;
+  /**
+   * Turns auto-renew off at the gateway: detaches or deletes the saved method so it can never be
+   * charged again. Idempotent (an already-removed method is success).
+   */
+  cancelAutoRenew(input: { paymentMethodRef: string }): Promise<void>;
+}
+
+export interface CreateCheckoutInput {
+  /** The checkout id: the gateway's idempotency key and our reference on its side. */
+  idempotencyKey: string;
+  method: 'promptpay' | 'card';
+  amountSatang: number;
+  currency: 'THB';
+  /** Short ASCII description shown by the gateway, e.g. `ShotX standard 3 months`. */
+  description: string;
+  /** The gateway must refuse payment after this (QR expiry). */
+  expiresAt: Date;
+  /** Card only: where the gateway sends the browser back (BILLING_CARD_RETURN_PATH). */
+  returnUrl: string | null;
+  /** Card only: save the card for auto-renew (always true today). */
+  saveCard: boolean;
+  /** For the gateway's own receipts and fraud checks; may be null (LINE accounts). */
+  customerEmail: string | null;
+}
+
+export type CreateCheckoutResult =
+  | {
+      method: 'promptpay';
+      /** The gateway's charge id: `payments.gateway_ref`. */
+      gatewayRef: string;
+      /** The EMVCo PromptPay payload the QR encodes (web renders it if there is no image). */
+      qrPayload: string;
+      /** The gateway's QR image as a `data:image/png;base64,...` or `data:image/svg+xml...` URL. */
+      qrImageDataUrl: string | null;
+      expiresAt: Date;
+    }
+  | {
+      method: 'card';
+      gatewayRef: string;
+      /** The gateway's hosted page (3-D Secure included). */
+      redirectUrl: string;
+      expiresAt: Date;
+    };
+
+export interface ChargeSavedMethodInput {
+  idempotencyKey: string;
+  paymentMethodRef: string;
+  amountSatang: number;
+  currency: 'THB';
+  description: string;
+}
+
+export interface ChargeSavedMethodResult {
+  gatewayRef: string;
+  status: 'pending' | 'paid' | 'failed';
+  /** The gateway's failure code when failed (e.g. `insufficient_fund`), for the event log. */
+  failureCode: string | null;
+}
+
+/** What the API hands an adapter: the exact body bytes and the lowercase headers. */
+export interface RawWebhookRequest {
+  rawBody: Uint8Array;
+  headers: Readonly<Record<string, string | undefined>>;
+}
+
+/**
+ * A webhook as the platform understands it, whatever the gateway:
+ * - `eventRef`: the gateway's event id, or `{gatewayRef}:{type}` when it has none. Webhooks are
+ *   deduplicated by (gateway, eventRef) in `payment_webhook_events`; the payment is found by
+ *   (gateway, gatewayRef), the UNIQUE key of `payments`.
+ * - `type`: `paid`, `failed`, `expired` (an unpaid QR timed out) or `refunded`.
+ * - `paymentMethodRef`: the saved card's reference on a paid card charge, else null.
+ */
+export const normalizedPaymentEventSchema = z.object({
+  gateway: z.enum(PAYMENT_GATEWAYS),
+  eventRef: z.string().min(1).max(255),
+  gatewayRef: z.string().min(1).max(255),
+  type: z.enum(PAYMENT_EVENT_TYPES),
+  amountSatang: satangSchema,
+  currency: z.literal('THB'),
+  occurredAt: z.date(),
+  paymentMethodRef: z.string().min(1).max(255).nullable(),
+  failureCode: z.string().min(1).max(64).nullable(),
+});
+export type NormalizedPaymentEvent = z.output<typeof normalizedPaymentEventSchema>;
+
+/**
+ * Where the gateway's card page returns the browser: PUBLIC_BASE_URL + this + `?payment={id}`.
+ * The studio page polls GET /billing/payments/:id; the return itself proves nothing.
+ */
+export const BILLING_CARD_RETURN_PATH = '/studio/billing/return';
diff --git a/packages/shared/src/billing/money.ts b/packages/shared/src/billing/money.ts
new file mode 100644
index 0000000..e4dbc5e
--- /dev/null
+++ b/packages/shared/src/billing/money.ts
@@ -0,0 +1,132 @@
+import { z } from 'zod';
+
+/**
+ * Money is integer satang (1 THB = 100 satang) everywhere: database, API, gateway calls. Every
+ * plan price is VAT-inclusive (7%). These helpers are the only place amounts are derived, so api,
+ * worker, web (display only) and admin rollups agree to the satang.
+ */
+
+/** Largest amount the helpers accept: 1 billion THB, far below 2^53 after multiplying. */
+export const MAX_AMOUNT_SATANG = 100_000_000_000;
+
+const BASIS_POINTS = 10_000;
+
+function assertSatang(label: string, value: number): void {
+  if (!Number.isSafeInteger(value) || value < 0 || value > MAX_AMOUNT_SATANG) {
+    throw new RangeError(`${label} must be an integer amount of satang, got ${value}`);
+  }
+}
+
+function assertBasisPoints(value: number): void {
+  if (!Number.isInteger(value) || value < 0 || value > BASIS_POINTS) {
+    throw new RangeError(`vatRateBasisPoints must be an integer from 0 to 10000, got ${value}`);
+  }
+}
+
+/**
+ * `round(a × b / c)` for non-negative integers, rounding half up (away from zero), exactly:
+ * `floor((2ab + c) / 2c)`. Callers keep `2ab` below 2^53.
+ */
+export function mulDivRoundHalfUp(a: number, b: number, c: number): number {
+  if (c <= 0) throw new RangeError('divisor must be positive');
+  return Math.floor((2 * a * b + c) / (2 * c));
+}
+
+/**
+ * VAT contained in a VAT-inclusive total, in satang. Rule (deterministic, documented for
+ * receipts): `vat = round_half_up(total × rate / (10000 + rate))` with the rate in basis points,
+ * and `net = total − vat`, so net + VAT always equals the price the customer saw. Example at 7%:
+ * 14,900 satang → VAT 975 (974.77 rounded), net 13,925.
+ */
+export function vatFromInclusive(totalSatang: number, vatRateBasisPoints: number): number {
+  assertSatang('totalSatang', totalSatang);
+  assertBasisPoints(vatRateBasisPoints);
+  return mulDivRoundHalfUp(totalSatang, vatRateBasisPoints, BASIS_POINTS + vatRateBasisPoints);
+}
+
+export interface AmountBreakdown {
+  /** What the customer pays, VAT included. */
+  totalSatang: number;
+  vatSatang: number;
+  /** `total − vat`. */
+  netSatang: number;
+  vatRateBasisPoints: number;
+}
+
+/** Splits a VAT-inclusive total (see vatFromInclusive). */
+export function splitVat(totalSatang: number, vatRateBasisPoints: number): AmountBreakdown {
+  const vatSatang = vatFromInclusive(totalSatang, vatRateBasisPoints);
+  return { totalSatang, vatSatang, netSatang: totalSatang - vatSatang, vatRateBasisPoints };
+}
+
+export const satangSchema = z.number().int().nonnegative().max(MAX_AMOUNT_SATANG);
+
+export const amountBreakdownSchema = z.object({
+  totalSatang: satangSchema,
+  vatSatang: satangSchema,
+  netSatang: satangSchema,
+  vatRateBasisPoints: z.number().int().min(0).max(BASIS_POINTS),
+});
+
+/** The prices of a plan row (`plans`), VAT-inclusive satang. */
+export interface PlanPrices {
+  priceMonthSatang: number;
+  priceYearSatang: number;
+}
+
+/**
+ * Price of `months` months of a plan: whole years at the yearly price, the rest at the monthly
+ * price (`floor(m / 12) × year + (m mod 12) × month`). So 12 months cost the yearly price (the
+ * discount the spec lists), and 1, 3 and 6 months cost 1, 3 and 6 monthly prices.
+ */
+export function periodPriceSatang(plan: PlanPrices, months: number): number {
+  assertSatang('priceMonthSatang', plan.priceMonthSatang);
+  assertSatang('priceYearSatang', plan.priceYearSatang);
+  if (!Number.isInteger(months) || months < 1 || months > 120) {
+    throw new RangeError(`months must be an integer from 1 to 120, got ${months}`);
+  }
+  const total =
+    Math.floor(months / 12) * plan.priceYearSatang + (months % 12) * plan.priceMonthSatang;
+  assertSatang('period price', total);
+  return total;
+}
+
+const MS_PER_DAY = 24 * 60 * 60 * 1000;
+
+export interface ProrationInput {
+  /** Monthly price of the current plan and of the bigger plan. */
+  fromPriceMonthSatang: number;
+  toPriceMonthSatang: number;
+  periodEnd: Date;
+  now: Date;
+  /** BILLING_PRORATION_DAYS_PER_MONTH (30). */
+  daysPerMonth: number;
+}
+
+export interface Proration {
+  /** Started days left until `period_end`, rounded up (a started day counts); 0 once it passed. */
+  remainingDays: number;
+  /** `round_half_up(max(0, to − from) × remainingDays / daysPerMonth)`. */
+  amountSatang: number;
+}
+
+/**
+ * Charge for an immediate upgrade: the monthly price difference for the remaining days of the
+ * current period. Monthly prices are used whatever was paid (a yearly prepayment's discount is
+ * not refunded or re-priced). An amount below BILLING_MIN_CHARGE_SATANG is waived: the upgrade
+ * applies without a payment (planCheckoutCharge).
+ */
+export function prorateUpgrade(input: ProrationInput): Proration {
+  assertSatang('fromPriceMonthSatang', input.fromPriceMonthSatang);
+  assertSatang('toPriceMonthSatang', input.toPriceMonthSatang);
+  if (!Number.isInteger(input.daysPerMonth) || input.daysPerMonth < 1) {
+    throw new RangeError('daysPerMonth must be a positive integer');
+  }
+  const remainingMs = input.periodEnd.getTime() - input.now.getTime();
+  const remainingDays = remainingMs > 0 ? Math.ceil(remainingMs / MS_PER_DAY) : 0;
+  const difference = Math.max(0, input.toPriceMonthSatang - input.fromPriceMonthSatang);
+  return {
+    remainingDays,
+    amountSatang: mulDivRoundHalfUp(difference, remainingDays, input.daysPerMonth),
+  };
+}
diff --git a/packages/shared/src/billing/notices.ts b/packages/shared/src/billing/notices.ts
new file mode 100644
index 0000000..f88b563
--- /dev/null
+++ b/packages/shared/src/billing/notices.ts
@@ -0,0 +1,72 @@
+import type { SubscriptionStatus } from '../domain';
+import { addDays } from './period';
+import { type LifecycleDays, subscriptionDeadlines } from './subscription';
+
+/**
+ * Renewal reminders at T-14, T-7 and T-1 (SUBSCRIPTION_REMINDER_DAYS) before `period_end`, for
+ * trial and active subscriptions (auto-renew ones too: the email says the card will be charged).
+ * The daily job sends at most one per run and subscription: the most urgent reminder that is due
+ * (`now >= period_end - d days`, still before period_end) and not yet logged in
+ * `subscription_notices` (kind `renewal_reminder`, this period_end, days_before = d). Earlier
+ * reminders a missed run skipped are never sent late. Renewing moves period_end, so the next
+ * period gets its own reminders.
+ *
+ * Returns the day count to send (and log), or null.
+ */
+export function dueRenewalReminder(input: {
+  status: SubscriptionStatus;
+  periodEnd: Date;
+  now: Date;
+  /** RetentionConfig.subscription.reminderDays. */
+  reminderDays: readonly number[];
+  /** days_before values already logged for this subscription and period_end. */
+  sentDays: ReadonlySet<number>;
+}): number | null {
+  if (input.status !== 'trial' && input.status !== 'active') return null;
+  const t = input.now.getTime();
+  if (t >= input.periodEnd.getTime()) return null;
+  const due = input.reminderDays.filter((d) => t >= addDays(input.periodEnd, -d).getTime());
+  if (due.length === 0) return null;
+  const mostUrgent = Math.min(...due);
+  return input.sentDays.has(mostUrgent) ? null : mostUrgent;
+}
+
+/**
+ * The purge warning: once for an expired subscription, from `purgeAt - purgeWarningDays` until
+ * the purge (logged as kind `purge_warning`, days_before = purgeWarningDays).
+ */
+export function purgeWarningDue(input: {
+  status: SubscriptionStatus;
+  periodEnd: Date;
+  now: Date;
+  days: LifecycleDays;
+  alreadySent: boolean;
+}): boolean {
+  if (input.status !== 'expired' || input.alreadySent) return false;
+  const d = subscriptionDeadlines(input.periodEnd, input.days);
+  const t = input.now.getTime();
+  return t >= d.purgeWarningAt.getTime() && t < d.purgeAt.getTime();
+}
+
+/**
+ * Fair-use alert (Phase 5 admin; the spec's rule): an account is anomalous in a month when its
+ * egress (bytes served, `daily_stats.bytes_out` summed over the month) exceeds
+ * EGRESS_ANOMALY_MULTIPLIER (20) × its stored bytes (`storage_usage.used_bytes` at month end),
+ * and is at least EGRESS_ANOMALY_MIN_BYTES so tiny accounts don't alert. Alerts only; nothing is
+ * throttled.
+ */
+export function isEgressAnomalous(
+  usage: { monthlyEgressBytes: number; storedBytes: number },
+  rule: { multiplier: number; minBytes: number },
+): boolean {
+  const { monthlyEgressBytes: egress, storedBytes: stored } = usage;
+  for (const [label, v] of [
+    ['monthlyEgressBytes', egress],
+    ['storedBytes', stored],
+  ] as const) {
+    if (!Number.isSafeInteger(v) || v < 0) {
+      throw new RangeError(`${label} must be a non-negative safe integer`);
+    }
+  }
+  return egress >= rule.minBytes && egress > rule.multiplier * stored;
+}
diff --git a/packages/shared/src/billing/period.ts b/packages/shared/src/billing/period.ts
new file mode 100644
index 0000000..a90271e
--- /dev/null
+++ b/packages/shared/src/billing/period.ts
@@ -0,0 +1,62 @@
+/**
+ * Billing periods run in the operator's time zone, Asia/Bangkok (UTC+7, no daylight saving).
+ * Timestamps are stored as `timestamptz`; month arithmetic happens on Bangkok wall-clock dates.
+ */
+
+export const BILLING_TIME_ZONE = 'Asia/Bangkok';
+
+/** Bangkok is UTC+7 all year (no DST since 1920), so a fixed offset is exact. */
+export const BANGKOK_UTC_OFFSET_MS = 7 * 60 * 60 * 1000;
+
+export const MS_PER_BILLING_DAY = 24 * 60 * 60 * 1000;
+
+function assertDate(label: string, value: Date): void {
+  if (!(value instanceof Date) || Number.isNaN(value.getTime())) {
+    throw new RangeError(`${label} must be a valid Date`);
+  }
+}
+
+function daysInMonth(year: number, monthIndex: number): number {
+  return new Date(Date.UTC(year, monthIndex + 1, 0)).getUTCDate();
+}
+
+/**
+ * `date` plus `months` calendar months on the Bangkok wall clock, keeping the time of day, with
+ * month-end clamping: Jan 31 + 1 month is Feb 28 (29 in leap years), Mar 31 + 1 is Apr 30. Adding
+ * to `period_end` repeatedly can drift after a clamp (Jan 31 → Feb 28 → Mar 28); that is
+ * accepted, because each renewal appends to the stored `period_end`.
+ */
+export function addMonthsBangkok(date: Date, months: number): Date {
+  assertDate('date', date);
+  if (!Number.isInteger(months) || months < 0 || months > 1200) {
+    throw new RangeError(`months must be an integer from 0 to 1200, got ${months}`);
+  }
+  const wall = new Date(date.getTime() + BANGKOK_UTC_OFFSET_MS);
+  const total = wall.getUTCFullYear() * 12 + wall.getUTCMonth() + months;
+  const year = Math.floor(total / 12);
+  const month = total % 12;
+  const day = Math.min(wall.getUTCDate(), daysInMonth(year, month));
+  const result = Date.UTC(
+    year,
+    month,
+    day,
+    wall.getUTCHours(),
+    wall.getUTCMinutes(),
+    wall.getUTCSeconds(),
+    wall.getUTCMilliseconds(),
+  );
+  return new Date(result - BANGKOK_UTC_OFFSET_MS);
+}
+
+/** `date` plus whole days (exact 24 h steps: Bangkok has no DST). Negative days go back. */
+export function addDays(date: Date, days: number): Date {
+  assertDate('date', date);
+  if (!Number.isInteger(days)) throw new RangeError(`days must be an integer, got ${days}`);
+  return new Date(date.getTime() + days * MS_PER_BILLING_DAY);
+}
+
+/** The Bangkok calendar date of an instant, `YYYY-MM-DD`. */
+export function bangkokDate(date: Date): string {
+  assertDate('date', date);
+  return new Date(date.getTime() + BANGKOK_UTC_OFFSET_MS).toISOString().slice(0, 10);
+}
diff --git a/packages/shared/src/billing/subscription.ts b/packages/shared/src/billing/subscription.ts
new file mode 100644
index 0000000..bd7cf32
--- /dev/null
+++ b/packages/shared/src/billing/subscription.ts
@@ -0,0 +1,608 @@
+import type {
+  AutoRenewMonths,
+  BillingMode,
+  CheckoutChangeType,
+  PlanChangeInvalidReason,
+  SubscriptionEventType,
+  SubscriptionStatus,
+} from '../domain';
+import { availableBytes, type QuotaState } from '../drive/quota';
+import { periodPriceSatang, type PlanPrices, prorateUpgrade } from './money';
+import { addDays, addMonthsBangkok } from './period';
+
+/*
+ * Subscription lifecycle (spec "Plans, quota and billing"). Pure rules only: the api applies
+ * checkouts and webhooks, the worker's `subscriptions.transition.daily` job applies time-driven
+ * steps, both inside one transaction per subscription.
+ *
+ *   trial ──new──────────────▶ active ◀──renew/upgrade/downgrade (stays active)
+ *     │                         │  ▲
+ *     │ period_end              │  │ renew (from period_end) / new (other plan, from now)
+ *     ▼                         ▼  │
+ *   grace (period_end + SUBSCRIPTION_GRACE_DAYS: uploads blocked, shares work)
+ *     │ grace over                 ▲ renew (from now) / new
+ *     ▼                            │
+ *   expired (shares "ลิงก์นี้หมดอายุ"; owner can log in, renew, download) ─┘
+ *     │ SUBSCRIPTION_PURGE_AFTER_EXPIRY_DAYS later
+ *     ▼
+ *   purged (S3 objects and the Rekognition collection deleted; billing rows kept). Terminal: a
+ *          `new` checkout afterwards inserts a new subscription row.
+ *
+ * Assumption: a trial that runs out goes to grace like a paid period (its shares keep working for
+ * the grace days, uploads stop), then expired and purged on the same clock.
+ *
+ * Transaction patterns (money and quota change in one transaction; READ COMMITTED is enough
+ * because every step locks the rows it changes):
+ *
+ * Checkout (POST /billing/checkout), idempotent by (photographer, Idempotency-Key):
+ *   BEGIN;
+ *   INSERT INTO checkout_sessions (photographer_id, idempotency_key, request_sha256, ...)
+ *     VALUES (...) ON CONFLICT (photographer_id, idempotency_key) DO NOTHING RETURNING id;
+ *     -- no row: SELECT the existing one; same request_sha256 -> replay its response (or
+ *     -- CHECKOUT_EXPIRED when it expired); other hash -> IDEMPOTENCY_KEY_REUSED
+ *     -- checkout_sessions_one_pending_per_photographer violated -> CHECKOUT_PENDING
+ *   SELECT ... FROM subscriptions WHERE photographer_id = $p ORDER BY created_at DESC LIMIT 1
+ *     FOR UPDATE;   -- classifyCheckout + planCheckoutCharge against the locked state
+ *   COMMIT;
+ *   createCheckout at the gateway with idempotency key = checkout id (outside the transaction:
+ *   never hold row locks across a network call);
+ *   INSERT INTO payments (photographer_id, subscription_id, checkout_id, gateway, gateway_ref,
+ *     amount_satang, vat_satang, method, status 'pending') ON CONFLICT DO NOTHING;
+ *     -- payments_checkout_unique: one payment per checkout; then SELECT it
+ *   UPDATE checkout_sessions SET qr_payload = ..., redirect_url = ... WHERE id = $c;
+ *   A crash between the steps is healed by the client's retry with the same key: the checkout
+ *   exists without a payment, so createCheckout is called again with the same gateway key.
+ *   Before the first INSERT the API expires stale checkouts:
+ *   UPDATE checkout_sessions SET status = 'expired', finished_at = now()
+ *     WHERE photographer_id = $p AND status = 'pending' AND expires_at <= now();
+ *   (their payments stay `pending`: a late `paid` webhook is still applied if valid).
+ *   A charge of 0 (waived upgrade, card downgrade) applies the change in the first transaction and
+ *   marks the checkout `completed` without a payment.
+ *
+ * Webhook (POST /billing/webhooks/:gateway), idempotent by (gateway, event_ref) and by
+ * (gateway, gateway_ref) on payments:
+ *   verifyWebhook(raw body)            -- invalid: WEBHOOK_SIGNATURE_INVALID, nothing stored
+ *   BEGIN;
+ *   INSERT INTO payment_webhook_events (gateway, event_ref, gateway_ref, type, amount_satang,
+ *     payload_sha256, verified_at) VALUES (...) ON CONFLICT (gateway, event_ref) DO NOTHING
+ *     RETURNING id;                    -- no row and processed_at set: duplicate, COMMIT, 200
+ *   SELECT ... FROM payments WHERE gateway = $g AND gateway_ref = $ref FOR UPDATE;
+ *     -- none: leave processed_at null with error_code 'unknown_payment' (alert), COMMIT, 200
+ *   paid:     UPDATE payments SET status = 'paid', paid_at = $t, payment_method_ref = ...
+ *               WHERE id = $id AND status = 'pending';      -- no row: already final, skip
+ *             amount must equal payments.amount_satang, else error_code 'amount_mismatch' (alert)
+ *             SELECT subscription FOR UPDATE; applyCheckout (or applyRenewalPayment);
+ *             UPDATE subscriptions ...; INSERT subscription_events ...;
+ *             UPDATE checkout_sessions SET status = 'completed', finished_at = now()
+ *               WHERE id = $c AND status IN ('pending', 'expired');   -- late payments count
+ *             if the change is no longer valid: checkout 'failed' (PLAN_CHANGE_INVALID) and a
+ *             'payment_unapplied' event; the money stays recorded for an admin refund
+ *   failed/expired: UPDATE payments SET status = $type WHERE status = 'pending';
+ *             UPDATE checkout_sessions SET status = 'failed' | 'expired' WHERE status = 'pending'
+ *   refunded: UPDATE payments SET status = 'refunded', refunded_at = $t WHERE status = 'paid';
+ *             INSERT subscription_events 'payment_refunded' (no automatic subscription change)
+ *   UPDATE payment_webhook_events SET processed_at = now() WHERE id = $e;
+ *   COMMIT;  -- then 2xx. Any error before COMMIT: 500, the gateway retries.
+ *
+ * Quota: the plan's `quota_bytes` is read with the subscription row locked `FOR SHARE` in the
+ * upload reservation transaction (drive/quota), so a plan change and a reservation serialise.
+ * Plan changes never touch `storage_usage`: an upgrade raises the limit at once, an applied
+ * downgrade lowers it, and uploads stay blocked (QUOTA_EXCEEDED at init, uploadsBlockedBy) until
+ * used + reserved fits. Files are never deleted because of a downgrade.
+ */
+
+/** Everything that changes a subscription's status. */
+export const SUBSCRIPTION_TRANSITION_EVENTS = [
+  'checkout_new',
+  'checkout_renew',
+  'checkout_upgrade',
+  'checkout_downgrade',
+  'period_ended',
+  'grace_ended',
+  'purge_due',
+  'auto_renew_canceled',
+] as const;
+export type SubscriptionTransitionEvent = (typeof SUBSCRIPTION_TRANSITION_EVENTS)[number];
+
+export interface SubscriptionTransition {
+  from: SubscriptionStatus;
+  event: SubscriptionTransitionEvent;
+  to: SubscriptionStatus;
+}
+
+/**
+ * Every allowed transition. Anything not listed is forbidden (subscriptionTransition returns
+ * null), e.g. upgrading in grace, any checkout on a purged row, or going back from expired to
+ * grace.
+ */
+export const SUBSCRIPTION_TRANSITIONS: readonly SubscriptionTransition[] = [
+  { from: 'trial', event: 'checkout_new', to: 'active' },
+  { from: 'trial', event: 'period_ended', to: 'grace' },
+  { from: 'active', event: 'checkout_renew', to: 'active' },
+  { from: 'active', event: 'checkout_upgrade', to: 'active' },
+  { from: 'active', event: 'checkout_downgrade', to: 'active' },
+  { from: 'active', event: 'auto_renew_canceled', to: 'active' },
+  { from: 'active', event: 'period_ended', to: 'grace' },
+  { from: 'grace', event: 'checkout_renew', to: 'active' },
+  { from: 'grace', event: 'checkout_new', to: 'active' },
+  { from: 'grace', event: 'grace_ended', to: 'expired' },
+  { from: 'expired', event: 'checkout_renew', to: 'active' },
+  { from: 'expired', event: 'checkout_new', to: 'active' },
+  { from: 'expired', event: 'purge_due', to: 'purged' },
+];
+
+/** The status after `event`, or null when the transition is forbidden. */
+export function subscriptionTransition(
+  from: SubscriptionStatus,
+  event: SubscriptionTransitionEvent,
+): SubscriptionStatus | null {
+  return SUBSCRIPTION_TRANSITIONS.find((t) => t.from === from && t.event === event)?.to ?? null;
+}
+
+export const CHECKOUT_TRANSITION_EVENT = {
+  new: 'checkout_new',
+  renew: 'checkout_renew',
+  upgrade: 'checkout_upgrade',
+  downgrade: 'checkout_downgrade',
+} as const satisfies Record<CheckoutChangeType, SubscriptionTransitionEvent>;
+
+// --- Deadlines -------------------------------------------------------------------------------------
+
+export interface LifecycleDays {
+  /** SUBSCRIPTION_GRACE_DAYS (14). */
+  graceDays: number;
+  /** SUBSCRIPTION_PURGE_AFTER_EXPIRY_DAYS (45, 30–60). */
+  purgeAfterExpiryDays: number;
+  /** SUBSCRIPTION_PURGE_WARNING_DAYS (7). */
+  purgeWarningDays: number;
+}
+
+export interface SubscriptionDeadlines {
+  /** `period_end`: trial/active become grace. */
+  graceStartsAt: Date;
+  /** `period_end + graceDays`: grace becomes expired. */
+  expiresAt: Date;
+  /** `expiresAt + purgeAfterExpiryDays`: expired becomes purged. */
+  purgeAt: Date;
+  /** `purgeAt - purgeWarningDays`: the purge warning email. */
+  purgeWarningAt: Date;
+}
+
+/** Every time-driven deadline derives from `period_end` and the configured days. */
+export function subscriptionDeadlines(periodEnd: Date, days: LifecycleDays): SubscriptionDeadlines {
+  const expiresAt = addDays(periodEnd, days.graceDays);
+  const purgeAt = addDays(expiresAt, days.purgeAfterExpiryDays);
+  return {
+    graceStartsAt: periodEnd,
+    expiresAt,
+    purgeAt,
+    purgeWarningAt: addDays(purgeAt, -days.purgeWarningDays),
+  };
+}
+
+// --- Checkout classification ---------------------------------------------------------------------
+
+/** The current subscription as checkout rules need it (null: none yet). */
+export interface CurrentSubscription {
+  status: SubscriptionStatus;
+  planId: string;
+  /** The current plan's quota and monthly price. */
+  quotaBytes: number;
+  priceMonthSatang: number;
+  billing: BillingMode;
+  cancelAtPeriodEnd: boolean;
+  periodStart: Date;
+  periodEnd: Date;
+  /** A scheduled downgrade (`pending_plan_id`), or null. */
+  pendingPlanId: string | null;
+}
+
+/** A purchasable plan: active and not the trial (the API's lookup answers PLAN_NOT_FOUND else). */
+export interface TargetPlan extends PlanPrices {
+  id: string;
+  quotaBytes: number;
+}
+
+/**
+ * The change a checkout of `target` makes, from the current state:
+ * - none, purged or trial: `new`;
+ * - expired or grace: `renew` for the same plan, else `new`;
+ * - active: `renew` for the same plan; else bigger (quota, then monthly price) is `upgrade`,
+ *   anything else `downgrade`.
+ */
+export function classifyCheckout(
+  current: CurrentSubscription | null,
+  target: TargetPlan,
+): CheckoutChangeType {
+  if (current === null || current.status === 'purged' || current.status === 'trial') return 'new';
+  if (current.planId === target.id) return 'renew';
+  if (current.status !== 'active') return 'new';
+  const bigger =
+    target.quotaBytes > current.quotaBytes ||
+    (target.quotaBytes === current.quotaBytes &&
+      target.priceMonthSatang > current.priceMonthSatang);
+  return bigger ? 'upgrade' : 'downgrade';
+}
+
+/** How the checkout is paid (POST /billing/checkout `payment`). */
+export type CheckoutPayment =
+  { method: 'promptpay'; months: number | null } | { method: 'card'; months: AutoRenewMonths };
+
+export type CheckoutValidation =
+  | { ok: true; changeType: CheckoutChangeType }
+  | { ok: false; reason: PlanChangeInvalidReason; expected: CheckoutChangeType };
+
+/** Checks a checkout request against the state (in the transaction that locks it). */
+export function validateCheckout(input: {
+  current: CurrentSubscription | null;
+  target: TargetPlan;
+  declared: CheckoutChangeType;
+  payment: CheckoutPayment;
+  prepaidMonths: readonly number[];
+}): CheckoutValidation {
+  const { current, payment } = input;
+  const expected = classifyCheckout(current, input.target);
+  const fail = (reason: PlanChangeInvalidReason): CheckoutValidation => ({
+    ok: false,
+    reason,
+    expected,
+  });
+  if (input.declared !== expected) return fail('change_type_mismatch');
+  if (current?.pendingPlanId != null && current.status === 'active') {
+    return fail('pending_change_exists');
+  }
+  if (payment.method === 'promptpay') {
+    if (expected === 'upgrade') {
+      if (payment.months !== null) return fail('months_not_allowed');
+    } else {
+      if (payment.months === null) return fail('months_required');
+      if (!input.prepaidMonths.includes(payment.months)) return fail('months_not_offered');
+    }
+  } else {
+    const autoRenewOn = current?.billing === 'auto_renew';
+    if (expected === 'renew' && autoRenewOn && current?.status === 'active') {
+      return fail('auto_renew_active');
+    }
+    if (expected === 'downgrade' && !autoRenewOn) return fail('card_downgrade_needs_auto_renew');
+  }
+  return { ok: true, changeType: expected };
+}
+
+export interface CheckoutCharge {
+  /** VAT-inclusive amount to collect now; 0 means the change applies without a payment. */
+  amountSatang: number;
+  /** Months bought (prepaid) or the auto-renew interval (card); null for a PromptPay upgrade. */
+  months: number | null;
+  /** Upgrades only. */
+  proration: { remainingDays: number; amountSatang: number } | null;
+}
+
+/**
+ * What a validated checkout costs now:
+ * - new, renew: periodPriceSatang(target, months);
+ * - upgrade: prorateUpgrade, waived (0) when below `minChargeSatang`. A card upgrade charges the
+ *   proration too and switches the subscription to auto-renew with that card and interval;
+ * - downgrade with PromptPay: periodPriceSatang(target, months), for months that start at
+ *   `period_end`; with card (auto-renew): 0, the next renewal charges the smaller plan.
+ * Admins keep plan prices at or above BILLING_MIN_CHARGE_SATANG, so only proration is waived.
+ */
+export function planCheckoutCharge(input: {
+  changeType: CheckoutChangeType;
+  current: CurrentSubscription | null;
+  target: TargetPlan;
+  payment: CheckoutPayment;
+  now: Date;
+  daysPerMonth: number;
+  minChargeSatang: number;
+}): CheckoutCharge {
+  const { changeType, current, target, payment } = input;
+  if (changeType === 'upgrade') {
+    if (current === null) throw new RangeError('an upgrade needs a current subscription');
+    const proration = prorateUpgrade({
+      fromPriceMonthSatang: current.priceMonthSatang,
+      toPriceMonthSatang: target.priceMonthSatang,
+      periodEnd: current.periodEnd,
+      now: input.now,
+      daysPerMonth: input.daysPerMonth,
+    });
+    const amountSatang =
+      proration.amountSatang < input.minChargeSatang ? 0 : proration.amountSatang;
+    return {
+      amountSatang,
+      months: payment.method === 'card' ? payment.months : null,
+      proration,
+    };
+  }
+  if (payment.months === null) throw new RangeError(`${changeType} needs months`);
+  if (changeType === 'downgrade' && payment.method === 'card') {
+    return { amountSatang: 0, months: payment.months, proration: null };
+  }
+  return {
+    amountSatang: periodPriceSatang(target, payment.months),
+    months: payment.months,
+    proration: null,
+  };
+}
+
+// --- Applying a paid (or free) checkout ----------------------------------------------------------
+
+/** The subscription columns a change sets. */
+export interface SubscriptionValues {
+  status: SubscriptionStatus;
+  planId: string;
+  billing: BillingMode;
+  periodStart: Date;
+  periodEnd: Date;
+  cancelAtPeriodEnd: boolean;
+  /** Set exactly when billing is auto_renew. */
+  autoRenewMonths: AutoRenewMonths | null;
+  paymentMethodGateway: string | null;
+  paymentMethodRef: string | null;
+  pendingPlanId: string | null;
+  pendingPlanEffectiveAt: Date | null;
+}
+
+export interface AppliedChange {
+  values: SubscriptionValues;
+  /** Rows to insert into subscription_events, in order. */
+  events: SubscriptionEventType[];
+}
+
+export interface CheckoutToApply {
+  changeType: CheckoutChangeType;
+  targetPlanId: string;
+  payment: CheckoutPayment;
+  /** From the gateway's paid event when a card was saved; required for card payments. */
+  paymentMethod: { gateway: string; ref: string } | null;
+}
+
+/**
+ * The new subscription values after a checkout is paid (or applied free), at `now`. `current` is
+ * null for a first subscription or after purge: the caller inserts a new row with these values.
+ * Re-validate first (classifyCheckout must still give `changeType`): otherwise the payment is
+ * unapplied (see the webhook pattern above).
+ *
+ * - new: active, target plan, period [now, now + months]; card sets auto-renew, PromptPay prepaid.
+ * - renew: period_end + months from period_end (active, grace) or from now (expired, which also
+ *   restarts period_start).
+ * - upgrade: target plan now, period unchanged.
+ * - downgrade: PromptPay: pending plan from the old period_end, period_end + months; card: pending
+ *   plan from period_end, nothing else changes.
+ * A card payment always (re)enables auto-renew with the saved method and clears
+ * cancel_at_period_end.
+ */
+export function applyCheckout(
+  current: SubscriptionValues | null,
+  checkout: CheckoutToApply,
+  now: Date,
+): AppliedChange {
+  const { changeType, payment } = checkout;
+  const card = payment.method === 'card';
+  if (card && checkout.paymentMethod === null) {
+    throw new RangeError('a card checkout needs the saved payment method');
+  }
+  const billing = card
+    ? {
+        billing: 'auto_renew' as const,
+        autoRenewMonths: payment.months,
+        paymentMethodGateway: checkout.paymentMethod?.gateway ?? null,
+        paymentMethodRef: checkout.paymentMethod?.ref ?? null,
+        cancelAtPeriodEnd: false,
+      }
+    : null;
+  const enabledAutoRenew: SubscriptionEventType[] =
+    card && current?.billing !== 'auto_renew' ? ['auto_renew_enabled'] : [];
+  const months = payment.months;
+
+  if (changeType === 'new' || current === null) {
+    if (months === null) throw new RangeError('new needs months');
+    if (current !== null && subscriptionTransition(current.status, 'checkout_new') === null) {
+      throw new RangeError(`new is not allowed from ${current.status} (purged: insert a new row)`);
+    }
+    return {
+      values: {
+        status: 'active',
+        planId: checkout.targetPlanId,
+        billing: 'prepaid',
+        autoRenewMonths: null,
+        paymentMethodGateway: null,
+        paymentMethodRef: null,
+        cancelAtPeriodEnd: false,
+        ...billing,
+        periodStart: now,
+        periodEnd: addMonthsBangkok(now, months),
+        pendingPlanId: null,
+        pendingPlanEffectiveAt: null,
+      },
+      events: [current === null ? 'created' : 'activated', ...enabledAutoRenew],
+    };
+  }
+
+  const next = subscriptionTransition(current.status, CHECKOUT_TRANSITION_EVENT[changeType]);
+  if (next === null) {
+    throw new RangeError(`${changeType} is not allowed from ${current.status}`);
+  }
+  const base: SubscriptionValues = { ...current, ...billing, status: next };
+  switch (changeType) {
+    case 'renew': {
+      if (months === null) throw new RangeError('renew needs months');
+      const fromNow = current.status === 'expired';
+      return {
+        values: {
+          ...base,
+          periodStart: fromNow ? now : current.periodStart,
+          periodEnd: addMonthsBangkok(fromNow ? now : current.periodEnd, months),
+        },
+        events: ['renewed', ...enabledAutoRenew],
+      };
+    }
+    case 'upgrade':
+      return {
+        values: { ...base, planId: checkout.targetPlanId },
+        events: ['upgraded', ...enabledAutoRenew],
+      };
+    case 'downgrade':
+      return {
+        values: {
+          ...base,
+          pendingPlanId: checkout.targetPlanId,
+          pendingPlanEffectiveAt: current.periodEnd,
+          periodEnd:
+            payment.method === 'promptpay' && months !== null
+              ? addMonthsBangkok(current.periodEnd, months)
+              : current.periodEnd,
+        },
+        events: ['downgrade_scheduled', ...enabledAutoRenew],
+      };
+  }
+}
+
+/** A paid auto-renew charge: `autoRenewMonths` more from period_end (active or grace). */
+export function applyRenewalPayment(current: SubscriptionValues, now: Date): AppliedChange {
+  if (current.billing !== 'auto_renew' || current.autoRenewMonths === null) {
+    throw new RangeError('renewal payments need an auto-renew subscription');
+  }
+  const next = subscriptionTransition(current.status, 'checkout_renew');
+  if (next === null) throw new RangeError(`renewal not allowed from ${current.status}`);
+  const fromNow = current.status === 'expired';
+  return {
+    values: {
+      ...current,
+      status: next,
+      periodStart: fromNow ? now : current.periodStart,
+      periodEnd: addMonthsBangkok(fromNow ? now : current.periodEnd, current.autoRenewMonths),
+    },
+    events: ['renewed'],
+  };
+}
+
+/**
+ * POST /billing/subscription/cancel: auto-renew off at period end. The saved method is detached
+ * at the gateway (cancelAutoRenew) and forgotten; the subscription stays active until period_end
+ * and then runs out like a prepaid one. Idempotent: a prepaid subscription is returned unchanged.
+ */
+export function cancelAutoRenewValues(current: SubscriptionValues): AppliedChange {
+  if (current.billing !== 'auto_renew') return { values: current, events: [] };
+  return {
+    values: {
+      ...current,
+      billing: 'prepaid',
+      autoRenewMonths: null,
+      paymentMethodGateway: null,
+      paymentMethodRef: null,
+      cancelAtPeriodEnd: true,
+    },
+    events: ['auto_renew_canceled'],
+  };
+}
+
+// --- Daily job --------------------------------------------------------------------------------------
+
+export type LifecycleStep =
+  | { type: 'downgrade_applied'; planId: string }
+  | { type: 'grace_started' }
+  | { type: 'expired' }
+  | { type: 'purged' };
+
+/**
+ * What `subscriptions.transition.daily` must do for one subscription at `now`, in order. A missed
+ * run catches up: an active subscription long past its period can step to grace and expired in
+ * one run (each step writes its own subscription_events row and notice). A pending downgrade
+ * applies first, when `pending_plan_effective_at <= now`.
+ */
+export function dueLifecycleSteps(
+  current: Pick<
+    SubscriptionValues,
+    'status' | 'periodEnd' | 'pendingPlanId' | 'pendingPlanEffectiveAt'
+  >,
+  now: Date,
+  days: LifecycleDays,
+): LifecycleStep[] {
+  const steps: LifecycleStep[] = [];
+  const t = now.getTime();
+  if (
+    current.pendingPlanId !== null &&
+    current.pendingPlanEffectiveAt !== null &&
+    current.pendingPlanEffectiveAt.getTime() <= t &&
+    (current.status === 'active' || current.status === 'grace')
+  ) {
+    steps.push({ type: 'downgrade_applied', planId: current.pendingPlanId });
+  }
+  const deadlines = subscriptionDeadlines(current.periodEnd, days);
+  let status = current.status;
+  if ((status === 'trial' || status === 'active') && t >= deadlines.graceStartsAt.getTime()) {
+    steps.push({ type: 'grace_started' });
+    status = 'grace';
+  }
+  if (status === 'grace' && t >= deadlines.expiresAt.getTime()) {
+    steps.push({ type: 'expired' });
+    status = 'expired';
+  }
+  if (status === 'expired' && t >= deadlines.purgeAt.getTime()) {
+    steps.push({ type: 'purged' });
+  }
+  return steps;
+}
+
+/**
+ * Whether the daily job charges an auto-renew subscription now: auto-renew on, active or grace,
+ * `period_end - leadSeconds <= now` and still before the grace deadline, fewer than `maxAttempts`
+ * failed charges for this period_end and no pending or paid one (the partial unique index
+ * `payments_one_open_renewal` backs this up).
+ */
+export function renewalChargeDue(input: {
+  current: Pick<SubscriptionValues, 'status' | 'billing' | 'periodEnd'>;
+  now: Date;
+  leadSeconds: number;
+  maxAttempts: number;
+  graceDays: number;
+  failedAttemptsForPeriod: number;
+  openOrPaidForPeriod: boolean;
+}): boolean {
+  const { current, now } = input;
+  if (current.billing !== 'auto_renew') return false;
+  if (current.status !== 'active' && current.status !== 'grace') return false;
+  if (input.openOrPaidForPeriod || input.failedAttemptsForPeriod >= input.maxAttempts) return false;
+  const t = now.getTime();
+  return (
+    t >= current.periodEnd.getTime() - input.leadSeconds * 1000 &&
+    t < addDays(current.periodEnd, input.graceDays).getTime()
+  );
+}
+
+/**
+ * Amount of the next auto-renew charge: `autoRenewMonths` of the plan that applies at period_end
+ * (the pending downgrade's plan when it takes effect by then, else the current plan).
+ */
+export function renewalAmountSatang(plan: PlanPrices, autoRenewMonths: AutoRenewMonths): number {
+  return periodPriceSatang(plan, autoRenewMonths);
+}
+
+// --- Quota effects ----------------------------------------------------------------------------------
+
+/**
+ * Informational notice (BILLING_NOTICE_CODES) of a downgrade whose plan is smaller than what the
+ * photographer stores: uploads will be blocked from the effective date until used + reserved fits
+ * the new quota. Nothing is deleted. Null when it fits.
+ */
+export function downgradeQuotaNotice(
+  usage: Pick<QuotaState, 'usedBytes' | 'reservedBytes'>,
+  newQuotaBytes: number,
+): {
+  code: 'DOWNGRADE_EXCEEDS_QUOTA';
+  details: { quotaBytes: number; usedBytes: number; reservedBytes: number; overBytes: number };
+} | null {
+  const state = { ...usage, quotaBytes: newQuotaBytes };
+  const over = usage.usedBytes + usage.reservedBytes - newQuotaBytes;
+  if (over <= 0) return null;
+  availableBytes(state); // validates the counters
+  return {
+    code: 'DOWNGRADE_EXCEEDS_QUOTA',
+    details: {
+      quotaBytes: newQuotaBytes,
+      usedBytes: usage.usedBytes,
+      reservedBytes: usage.reservedBytes,
+      overBytes: over,
+    },
+  };
+}
