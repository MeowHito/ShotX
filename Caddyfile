shotx.yourdomain.com {
    # ── Frontend (Next.js) ───────────────────────────────────
    handle {
        reverse_proxy frontend:3000
    }
}

api.shotx.yourdomain.com {
    # ── Backend (NestJS) ─────────────────────────────────────
    handle {
        reverse_proxy backend:4000
    }
}

