# backup only (deploy/ops/backup.ts). Copy to env/backup.env, mode 0600.
APP_STAGE=prod
PGDATABASE=shotx
PGUSER=shotx
PGPASSWORD=REPLACE_ME

# A separate R2 bucket with a bucket lock, and a token scoped to that bucket only (never the
# media tokens). R2 has no write-only permission: Object Read & Write on this bucket.
BACKUP_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_REGION=auto
BACKUP_BUCKET=shotx-prod-backups
BACKUP_ACCESS_KEY_ID=REPLACE_ME
BACKUP_SECRET_ACCESS_KEY=REPLACE_ME
BACKUP_PREFIX=postgres/
# age public keys (age-keygen -y key.txt), comma-separated: the owner's, plus a break-glass key
# kept offline. The private keys are never on the VPS.
BACKUP_AGE_RECIPIENTS=REPLACE_ME
# Dumps older than this are deleted; the bucket lock must keep them at least this long.
BACKUP_RETENTION_DAYS=35
# 19:00 UTC = 02:00 Asia/Bangkok.
BACKUP_TIME_UTC=19:00
