# postgres only. Copy to env/postgres.env, mode 0600. The init script (deploy/postgres/01-init.sh)
# reads APP_DB_PASSWORD and MONITOR_DB_PASSWORD once, on an empty volume.
# Superuser, for maintenance only (never used by the services).
POSTGRES_USER=shotx_admin
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=shotx
# Role shotx (api, worker, migrate, backup): the PGPASSWORD of those env files.
APP_DB_PASSWORD=REPLACE_ME
# Role shotx_monitor: the PGPASSWORD of env/monitor.env.
MONITOR_DB_PASSWORD=REPLACE_ME
