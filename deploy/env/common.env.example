# Settings every ShotX service on the VPS shares (web, admin, api, worker, migrate, monitor). No secrets:
# those are in env/<service>.env. Copy to env/common.env (mode 0600 like the others).
# Tunables not listed here use their code defaults (see the repository's .env.example for every
# key and its meaning). docker-compose.yml fixes QUEUE_BACKEND, AUTH_PROVIDER, MEDIA_URL_SIGNER,
# API_INTERNAL_URL, REDIS_URL, PGHOST and the proxy address; don't set them here.

APP_STAGE=prod
NODE_ENV=production
LOG_LEVEL=info
PUBLIC_BASE_URL=https://photos.example.com
# The admin app (ADR 0010): https://<SHOTX_ADMIN_DOMAIN> of .env.production. Its origin checks,
# redirects and cookies use it; the shared app loader requires it in every service.
ADMIN_BASE_URL=https://admin.photos.example.com

# --- Database (password in the service env files) ----------------------------------------------
PGDATABASE=shotx
PGUSER=shotx

# --- Media storage: Cloudflare R2 (ADR 0008 section 2) ------------------------------------------
MEDIA_BUCKET=shotx-prod-media
STORAGE_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_REGION=auto
S3_FORCE_PATH_STYLE=true
STORAGE_ORIGINALS_CLASS=STANDARD

# --- AWS: SES only, ap-southeast-1 (keys per service) -------------------------------------------
AWS_REGION=ap-southeast-1
# Only with EMAIL_PROVIDER=ses.
SES_REGION=ap-southeast-1

# --- Face recognition on this VPS (ADR 0009) ----------------------------------------------------
# ONNX models in the api and worker images (FACE_MODEL_DIR=/app/models), vectors in Postgres.
# SFace is the development placeholder: set FACE_MODEL and the thresholds Phase 0 chose.
FACE_PROVIDER=self-hosted
FACE_DETECTOR_MODEL=yunet-2023mar
FACE_MODEL=sface-2021dec
# Face index expiry of a folder: creation or last upload + this many days (api writes it, worker
# purges after it; code default shown).
FACE_INDEX_EXPIRY_DAYS=90

# --- Features, consent, email, payments ---------------------------------------------------------
FACE_SEARCH_ENABLED=true
# Leave unset: the api then uses the newest consent policy version whose texts name FACE_PROVIDER's
# processor (now 2026-11-11b: our own servers in Kuala Lumpur, Malaysia). Outside APP_STAGE=local
# any other version is refused, so a pin here only makes the next deploy fail when the version is
# bumped. Older versions' texts stay only for old consent rows.
# CONSENT_POLICY_VERSION=
# Email is off at launch: nothing is sent and no SES_* setting or key is read. Switch to `ses`
# once SES sending is verified (then uncomment the sender below and the SES_* keys in env/api.env
# and env/worker.env). EMAIL_FROM_ADDRESS is needed only with `ses`.
EMAIL_PROVIDER=off
# EMAIL_FROM_ADDRESS=no-reply@photos.example.com
# EMAIL_FROM_NAME=ShotX

# --- Accounts and billing (ADR 0010) ------------------------------------------------------------
# offline: cash payments recorded by an admin, accounts created in the admin app; no gateway, so
# web hides plans and checkout and api/worker read no PAYMENT_* setting or secret.
BILLING_MODE=offline
# Only when BILLING_MODE=gateway (and the gateway's secrets in env/api.env and env/worker.env):
# PAYMENT_GATEWAY=omise
# Password minimums: api enforces them, web and admin show them and check before submitting, so
# all three read them from here (admin: 12-128, photographer: 8-128). The admin app's generated
# passwords (ADMIN_GENERATED_PASSWORD_LENGTH, env/admin.env) must be at least both.
ADMIN_PASSWORD_MIN_LENGTH=14
PHOTOGRAPHER_PASSWORD_MIN_LENGTH=10
# Refresh-token reuse grace: api, web and admin must agree (0-60 s).
AUTH_REFRESH_REUSE_GRACE_SECONDS=10

# --- Face search uploads (api and worker must agree; no code defaults) --------------------------
FACE_SEARCH_MAX_SELFIE_BYTES=4915200
FACE_SEARCH_MAX_BODY_BYTES=14811136

# --- Captcha after a rate-limit hit (ADR 0008 section 7) ----------------------------------------
CAPTCHA_PROVIDER=turnstile

# --- Media sweep (worker; the monitor reads the same values to tell a stuck file) ----------------
MEDIA_SWEEP_PROCESSING_AGE_SECONDS=21600
MEDIA_SWEEP_MAX_REQUEUES=3
