# monitor only (deploy/ops/monitor). Copy to env/monitor.env, mode 0600.
# PGUSER=shotx_monitor and REDIS_USERNAME=shotx-monitor are fixed in docker-compose.yml.
PGPASSWORD=REPLACE_ME
# REDIS_MONITOR_PASSWORD from the `ops redis-acl` run.
REDIS_PASSWORD=REPLACE_ME

# Where alerts go: any endpoint that takes a JSON POST (Slack/Mattermost/Google Chat use `text`,
# Discord `content`; `alerts` has the structured list). Secret: it usually embeds a token.
ALERT_WEBHOOK_URL=
# Optional dead man's switch: GET after every round (e.g. a healthchecks.io-style ping URL), so an
# external service alerts when the monitor or the whole VPS stops.
MONITOR_HEARTBEAT_URL=

# Thresholds (code defaults shown).
MONITOR_INTERVAL_SECONDS=60
MONITOR_REPEAT_SECONDS=3600
MONITOR_QUEUE_FAILED_MAX=0
MONITOR_QUEUE_MAX_WAIT_SECONDS=1800
# Per queue: MONITOR_MEDIA_MAX_WAIT_SECONDS, MONITOR_FACES_..., MONITOR_ZIP_..., MONITOR_JOBS_...
MONITOR_REDIS_MEMORY_PERCENT=75
MONITOR_FACE_DELETION_MAX_AGE_SECONDS=86400
MONITOR_BACKUP_MAX_AGE_SECONDS=93600
MONITOR_DISK_PERCENT=80
MONITOR_MEMORY_PERCENT=90
MONITOR_LOAD_PER_CPU=2
MONITOR_ALLOW_SWAP=false
MONITOR_MAX_IDS=20
