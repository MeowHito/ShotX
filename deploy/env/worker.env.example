# worker only. Copy to env/worker.env, mode 0600.

PGPASSWORD=REPLACE_ME
REDIS_PASSWORD=REPLACE_ME

# --- R2: the worker's own token (Object Read & Write on the media bucket only) ------------------
STORAGE_ACCESS_KEY_ID=REPLACE_ME
STORAGE_SECRET_ACCESS_KEY=REPLACE_ME

# --- AWS: IAM user shotx-<stage>-worker (SES sending) -------------------------------------------
# Rekognition keys only with FACE_PROVIDER=rekognition (ADR 0009):
# REKOGNITION_ACCESS_KEY_ID= REKOGNITION_SECRET_ACCESS_KEY=
SES_ACCESS_KEY_ID=REPLACE_ME
SES_SECRET_ACCESS_KEY=REPLACE_ME

# Auto-renew charges (subscriptions.transition.daily).
PAYMENT_OMISE_PUBLIC_KEY=REPLACE_ME
PAYMENT_OMISE_SECRET_KEY=REPLACE_ME
PAYMENT_OMISE_WEBHOOK_SECRET=REPLACE_ME
IP_HASH_SECRET=REPLACE_ME
SENTRY_DSN=

# --- Concurrency: what one VPS can take next to face search and Postgres ------------------------
# Per consumer: jobs in flight at once. Media runs sharp and ffmpeg; keep it low.
WORKER_MEDIA_CONCURRENCY=1
WORKER_FACES_CONCURRENCY=2
WORKER_ZIP_CONCURRENCY=1
WORKER_JOBS_CONCURRENCY=1
