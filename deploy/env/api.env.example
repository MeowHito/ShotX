# api only. Copy to env/api.env, mode 0600. Every REPLACE_ME is a secret; the api refuses to start
# while one is left (the loaders reject the placeholder).

# --- Database and Redis -------------------------------------------------------------------------
PGPASSWORD=REPLACE_ME
# REDIS_APP_PASSWORD from the `ops redis-acl` run.
REDIS_PASSWORD=REPLACE_ME

# --- R2: the api's own token (Object Read & Write on the media bucket only) ---------------------
STORAGE_ACCESS_KEY_ID=REPLACE_ME
STORAGE_SECRET_ACCESS_KEY=REPLACE_ME
# A second, read-only token for presigned GETs (optional; else the token above signs).
STORAGE_SIGNING_ACCESS_KEY_ID=
STORAGE_SIGNING_SECRET_ACCESS_KEY=

# --- AWS: IAM user shotx-<stage>-api (SES sending) ----------------------------------------------
# Rekognition keys only with FACE_PROVIDER=rekognition (ADR 0009):
# REKOGNITION_ACCESS_KEY_ID= REKOGNITION_SECRET_ACCESS_KEY=
SES_ACCESS_KEY_ID=REPLACE_ME
SES_SECRET_ACCESS_KEY=REPLACE_ME

# --- API-issued sign-in (ADR 0008 section 4) ----------------------------------------------------
# Same value as env/web.env.
AUTH_BFF_KEY=REPLACE_ME
# openssl genpkey -algorithm ed25519 -outform DER | base64   (one per pool, different keys)
AUTH_USERS_SIGNING_KEY=REPLACE_ME
AUTH_USERS_SIGNING_KEY_ID=users-1
AUTH_ADMINS_SIGNING_KEY=REPLACE_ME
AUTH_ADMINS_SIGNING_KEY_ID=admins-1
# openssl rand -base64 32
ADMIN_TOTP_ENCRYPTION_KEY=REPLACE_ME
LINE_LOGIN_CHANNEL_ID=REPLACE_ME
LINE_LOGIN_CHANNEL_SECRET=REPLACE_ME
GOOGLE_OAUTH_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_ME

# --- Other secrets ------------------------------------------------------------------------------
# HMAC key of consents.ip_hash and rate-limit keys: openssl rand -base64 48
IP_HASH_SECRET=REPLACE_ME
TURNSTILE_SECRET_KEY=REPLACE_ME
PAYMENT_OMISE_PUBLIC_KEY=REPLACE_ME
PAYMENT_OMISE_SECRET_KEY=REPLACE_ME
PAYMENT_OMISE_WEBHOOK_SECRET=REPLACE_ME
SENTRY_DSN=
