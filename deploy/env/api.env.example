# api only. Copy to env/api.env, mode 0600. Every REPLACE_ME is a secret; the api refuses to start
# while one is left (the loaders reject the placeholder).

# --- Database and Redis -------------------------------------------------------------------------
PGPASSWORD=REPLACE_ME
# REDIS_APP_PASSWORD from the `ops redis-acl` run.
REDIS_PASSWORD=REPLACE_ME

# --- R2: the api's own token (Object Read & Write on the media bucket only) ---------------------
STORAGE_ACCESS_KEY_ID=REPLACE_ME
STORAGE_SECRET_ACCESS_KEY=REPLACE_ME
# A second, read-only token for presigned GETs (optional; else the token above signs).
STORAGE_SIGNING_ACCESS_KEY_ID=
STORAGE_SIGNING_SECRET_ACCESS_KEY=

# --- AWS: IAM user shotx-<stage>-api (SES sending) ----------------------------------------------
# Rekognition keys only with FACE_PROVIDER=rekognition (ADR 0009):
# REKOGNITION_ACCESS_KEY_ID= REKOGNITION_SECRET_ACCESS_KEY=
# Only with EMAIL_PROVIDER=ses (env/common.env; off at launch):
# SES_ACCESS_KEY_ID=REPLACE_ME
# SES_SECRET_ACCESS_KEY=REPLACE_ME

# --- API-issued sign-in (ADR 0008 section 4) ----------------------------------------------------
# Two BFF keys, each at least 32 characters (openssl rand -base64 48), and different from each
# other (the api refuses equal values): web's (the same value as env/web.env) and the admin app's
# (the same value as env/admin.env).
AUTH_BFF_KEY=REPLACE_ME
AUTH_ADMIN_BFF_KEY=REPLACE_ME
# openssl genpkey -algorithm ed25519 -outform DER | base64   (one per pool, different keys)
AUTH_USERS_SIGNING_KEY=REPLACE_ME
AUTH_USERS_SIGNING_KEY_ID=users-1
AUTH_ADMINS_SIGNING_KEY=REPLACE_ME
AUTH_ADMINS_SIGNING_KEY_ID=admins-1
# Admin second factor (ADR 0011 decision 4): `off` (launch) signs admins in with email + password
# only; `totp` also asks for an authenticator code.
ADMIN_MFA_MODE=off
# Required only with ADMIN_MFA_MODE=totp (optional with off; when set, the operator CLI can still
# enrol TOTP ahead of a switch): openssl rand -base64 32
# ADMIN_TOTP_ENCRYPTION_KEY=REPLACE_ME
# Optional viewer sign-in, used only by shares with require_login. Each provider is enabled only
# when both its id and secret are set; leave them commented out to launch without it (a leftover
# REPLACE_ME is refused).
# LINE_LOGIN_CHANNEL_ID=REPLACE_ME
# LINE_LOGIN_CHANNEL_SECRET=REPLACE_ME
# GOOGLE_OAUTH_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_ME

# --- Other secrets ------------------------------------------------------------------------------
# HMAC key of consents.ip_hash and rate-limit keys: openssl rand -base64 48
IP_HASH_SECRET=REPLACE_ME
TURNSTILE_SECRET_KEY=REPLACE_ME
# Only when BILLING_MODE=gateway (env/common.env), with PAYMENT_GATEWAY=omise:
# PAYMENT_OMISE_PUBLIC_KEY=REPLACE_ME
# PAYMENT_OMISE_SECRET_KEY=REPLACE_ME
# PAYMENT_OMISE_WEBHOOK_SECRET=REPLACE_ME
SENTRY_DSN=

# --- Accounts (ADR 0010; code defaults shown) ---------------------------------------------------
# No storage limit for now: usage is still tracked; uploads never answer QUOTA_EXCEEDED.
STORAGE_QUOTA_ENFORCED=false
# Share links by slug (ADR 0011 risk 3; code defaults shown). Slugs are guessable, so lookups and
# NOT_FOUND answers are limited per client IP. Thai carriers put many people behind one address
# (CGNAT): keep these generous and size them from the load test (LOADTEST.md).
SHARE_SLUG_RESOLVE_RATE_PER_IP=300
SHARE_SLUG_RESOLVE_RATE_PER_IP_WINDOW_SECONDS=300
SHARE_NOT_FOUND_RATE_PER_IP=30
SHARE_NOT_FOUND_RATE_PER_IP_WINDOW_SECONDS=600
# Default page size of the admin users and cash-payment lists (1-200).
ADMIN_LIST_PAGE_SIZE=50
# Photographer sign-in (email + password): rate limits, lockout and the forced first change.
# ADR 0025 (owner, 2026-11-14): the rate limits and lockout below apply only when
# PHOTOGRAPHER_LOGIN_LIMITS_ENABLED=true; off, a photographer who mistypes is never told to wait.
PHOTOGRAPHER_LOGIN_LIMITS_ENABLED=false
PHOTOGRAPHER_LOGIN_RATE_PER_ACCOUNT=5
PHOTOGRAPHER_LOGIN_RATE_PER_ACCOUNT_WINDOW_SECONDS=900
PHOTOGRAPHER_LOGIN_RATE_PER_IP=20
PHOTOGRAPHER_LOGIN_RATE_PER_IP_WINDOW_SECONDS=900
PHOTOGRAPHER_LOGIN_LOCKOUT_THRESHOLD=10
PHOTOGRAPHER_LOGIN_LOCKOUT_SECONDS=900
PHOTOGRAPHER_PASSWORD_CHANGE_SESSION_TTL_SECONDS=1800

# --- "ลืมรหัสผ่าน": password reset by email (ADR 0025) -------------------------------------------
# off: no email can be sent, so the sign-in page says "ask the admin". smtp: any SMTP server, e.g.
# Gmail/Google Workspace (smtp.gmail.com, an App Password), Hostinger Mail (smtp.hostinger.com),
# Resend (smtp.resend.com, user "resend", password = API key). Port 465 = TLS; 587 = STARTTLS.
ACCOUNT_EMAIL_PROVIDER=off
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=REPLACE_ME
# SMTP_PASSWORD=REPLACE_ME
# The From address (default SMTP_USER); the provider must allow sending as it.
# ACCOUNT_EMAIL_FROM_ADDRESS=
ACCOUNT_EMAIL_FROM_NAME=Snap
# How long a reset link works, and reset emails per account per hour (more are dropped silently).
PHOTOGRAPHER_PASSWORD_RESET_TTL_SECONDS=3600
PHOTOGRAPHER_PASSWORD_RESET_EMAILS_PER_HOUR=5

# --- Packages, self sign-up and online payment (ADR 0026; shared config/packages.ts) -----------
# on: Free sign-up (/signup/free, needs ACCOUNT_EMAIL_PROVIDER) and paid orders (/package-orders).
# off (default): both answer NOT_FOUND; the home page still lists the packages.
PACKAGE_SALES=off
# off (default) | fake (local/test only) | mpay. off: paid cards say "online payment opens soon".
PACKAGE_GATEWAY=off
# Only with PACKAGE_GATEWAY=mpay (ADR 0029, mPAY ONE); MPAY_SECRET_KEY is a secret (the merchant's
# channel secret). Production API: https://api.paymentgateway.ais.co.th/prod
# (staging: https://api.stg-paymentgateway.ais.co.th/stg). Register the Payment Notify callback
# with mPAY: https://<site>/api/package-payments/webhooks/mpay
# MPAY_API_URL=https://REPLACE_ME
# MPAY_MERCHANT_ID=REPLACE_ME
# MPAY_SECRET_KEY=REPLACE_ME
# MPAY_SERVICE_ID=REPLACE_ME
# Pay page methods in order: qr (PromptPay) and/or card; only those mPAY switched on.
# MPAY_METHODS=qr,card
# MPAY_QR_EXPIRE_SECONDS=600
# MPAY_TIMEOUT_MS=15000
PACKAGES_FEATURED_CODE=d7
PACKAGES_CACHE_MAX_AGE_SECONDS=60
# Free sign-up: requests per IP per window, link emails per address per hour, all sign-up emails
# per day (Gmail SMTP caps ~500/day, shared with password reset), link lifetime. With
# CAPTCHA_PROVIDER=turnstile the form also needs a Turnstile token.
SIGNUP_RATE_PER_IP=5
SIGNUP_RATE_PER_IP_WINDOW_SECONDS=3600
SIGNUP_EMAILS_PER_HOUR=3
SIGNUP_EMAILS_PER_DAY=200
SIGNUP_LINK_TTL_SECONDS=86400
# Paid orders: per-IP limit, the "set your password" link lifetime for accounts created on payment,
# and when/how often the return page asks the gateway about a pending order.
PACKAGE_ORDER_RATE_PER_IP=20
PACKAGE_ORDER_RATE_PER_IP_WINDOW_SECONDS=3600
PACKAGE_SET_PASSWORD_TTL_SECONDS=604800
PACKAGE_ORDER_INQUIRE_AFTER_SECONDS=30
PACKAGE_ORDER_INQUIRE_INTERVAL_SECONDS=20
# POST /package-orders/:id/pay per order and window (ADR 0029).
PACKAGE_PAY_RATE_PER_ORDER=10
PACKAGE_PAY_RATE_PER_ORDER_WINDOW_SECONDS=600
# Coupons (ADR 0030): how long a pending order holds one use; checks per IP and window.
PACKAGE_COUPON_HOLD_SECONDS=1800
PACKAGE_COUPON_CHECK_RATE_PER_IP=30
PACKAGE_COUPON_CHECK_RATE_PER_IP_WINDOW_SECONDS=600
