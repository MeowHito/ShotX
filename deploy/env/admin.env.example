# admin only (apps/admin, ADR 0010). Copy to env/admin.env, mode 0600.
# docker-compose.yml fixes AUTH_PROVIDER=shotx, API_INTERNAL_URL and PORT; ADMIN_BASE_URL,
# PUBLIC_BASE_URL, APP_STAGE and the password minimums come from env/common.env.

# The admin app's own BFF key (x-shotx-bff-key): the same value as AUTH_ADMIN_BFF_KEY in
# env/api.env, different from web's AUTH_BFF_KEY, which the admin app never holds. Secret, at least
# 32 characters: openssl rand -base64 48
AUTH_ADMIN_BFF_KEY=REPLACE_ME

# Length of the passwords the "generate" button makes for new accounts and resets (16-128); at
# least ADMIN_PASSWORD_MIN_LENGTH and PHOTOGRAPHER_PASSWORD_MIN_LENGTH, or the app won't start.
ADMIN_GENERATED_PASSWORD_LENGTH=20
# Timeout of the app's sign-in calls to the api (1000-120000 ms; code default shown).
AUTH_CLIENT_TIMEOUT_MS=15000
