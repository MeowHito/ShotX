# web only. Copy to env/web.env, mode 0600.
# Shared with api only (x-shotx-bff-key; the admin app has its own AUTH_ADMIN_BFF_KEY); at least
# 32 characters: openssl rand -base64 48
AUTH_BFF_KEY=REPLACE_ME
# Cloudflare Turnstile site key (public).
TURNSTILE_SITE_KEY=REPLACE_ME
# Optional.
SENTRY_DSN=
# Optional: Google Analytics 4 measurement id (G-XXXXXXXXXX), on every web page, never the
# admin app (ADR 0017). Empty: no analytics.
GA_MEASUREMENT_ID=
