# Compose-level settings of the VPS deployment (docker compose --env-file .env.production).
# Copy to .env.production (mode 0600). No secrets here: those are in env/*.env.
# App settings (what web, api and worker read) are in env/common.env and env/<service>.env.

# --- Domain and TLS ----------------------------------------------------------------------------
# The main site; PUBLIC_BASE_URL in env/common.env is https://<this>.
SHOTX_DOMAIN=photos.example.com
# The admin app (ADR 0010); ADMIN_BASE_URL in env/common.env is https://<this>. Its own DNS record
# to the VPS, and its own certificate.
SHOTX_ADMIN_DOMAIN=admin.photos.example.com
# Let's Encrypt account email (expiry warnings).
ACME_EMAIL=ops@example.com

# --- Images ------------------------------------------------------------------------------------
SHOTX_IMAGE_PREFIX=shotx
SHOTX_IMAGE_TAG=latest
CADDY_VERSION=2.10-alpine
POSTGRES_VERSION=18-alpine
REDIS_VERSION=7.2-alpine
# Where the env files are (env/*.env next to this file by default).
SHOTX_ENV_DIR=./env
# Generated by `ops redis-acl` (deploy/README.md); holds password hashes, mode 0600.
REDIS_ACL_FILE=./redis/users.acl

# --- Networks ----------------------------------------------------------------------------------
# Change only if they clash with the host's networks. TRUSTED_PROXY_ADDRESSES follows
# SHOTX_PROXY_IP and SHOTX_PROXY_IP6 automatically; each must be inside its edge subnet.
SHOTX_EDGE_SUBNET=172.30.0.0/24
SHOTX_PROXY_IP=172.30.0.10
# IPv6 on the edge network (a private ULA range), so IPv6 visitors keep their own address.
SHOTX_EDGE_SUBNET6=fd30:0:0:1::/64
SHOTX_PROXY_IP6=fd30:0:0:1::10
SHOTX_DATA_SUBNET=172.30.1.0/24
SHOTX_EGRESS_SUBNET=172.30.2.0/24

# --- Proxy body limits (the apps enforce the real limits; these are a ceiling) ----------------
# Selfie uploads: at least FACE_SEARCH_MAX_BODY_BYTES (env/common.env).
PROXY_SELFIE_MAX_BODY=16MB
# Other /api/* bodies: at least UPLOAD_COMPLETE_BODY_MAX_BYTES (1 MiB by default).
PROXY_API_MAX_BODY=2MB
PROXY_WEB_MAX_BODY=2MB
# The admin site (JSON bodies of a few hundred bytes).
PROXY_ADMIN_MAX_BODY=1MB

# --- Resources ---------------------------------------------------------------------------------
# Sized for a 4 vCPU / 8 GB VPS (open question 2 in ADR 0008). Keep the memory limits' sum
# below the host's memory minus ~1 GB for the OS: with swap off, an overcommitted box OOM-kills.
# The CPU limits keep ffmpeg and sharp (worker) from starving face search (api) and Postgres.
PROXY_CPUS=0.5
PROXY_MEMORY=256m
WEB_CPUS=1
WEB_MEMORY=768m
ADMIN_CPUS=0.5
ADMIN_MEMORY=384m
API_CPUS=1.5
API_MEMORY=1280m
WORKER_CPUS=2
WORKER_MEMORY=2g
WORKER_VIPS_CONCURRENCY=2
POSTGRES_CPUS=1.5
POSTGRES_MEMORY=1536m
PG_SHARED_BUFFERS=384MB
PG_EFFECTIVE_CACHE_SIZE=1GB
PG_MAX_CONNECTIONS=100
PG_LOG_MIN_DURATION_MS=2000
REDIS_CPUS=0.5
# ADR 0008 section 3: noeviction with an explicit cap. The monitor alerts at
# MONITOR_REDIS_MEMORY_PERCENT of it. REDIS_MEMORY (the container limit) stays well above it.
REDIS_MAXMEMORY=512mb
REDIS_MEMORY=896m

# --- Worker shutdown ---------------------------------------------------------------------------
# Running jobs get WORKER_SHUTDOWN_GRACE_SECONDS after SIGTERM; Docker kills the container after
# WORKER_STOP_GRACE_PERIOD, which must be at least the grace plus 5 s.
WORKER_SHUTDOWN_GRACE_SECONDS=20
WORKER_STOP_GRACE_PERIOD=30s

# --- Logs --------------------------------------------------------------------------------------
LOG_MAX_SIZE=20m
LOG_MAX_FILES=5
