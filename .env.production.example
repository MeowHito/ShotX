# ============================================================
#  ShotX — Production Environment Variables
#
#  วิธีใช้:
#    cp .env.production.example .env.production
#    nano .env.production      ← แก้ค่าที่มี  ← CHANGE THIS
#
#  ห้าม commit .env.production ขึ้น git เด็ดขาด!
# ============================================================

# ── Domain / URLs ─────────────────────────────────────────────
# ใส่ domain จริงที่ชี้มาที่ Droplet
APP_URL=https://shotx.yourdomain.com              # ← CHANGE THIS
NEXT_PUBLIC_API_URL=https://api.shotx.yourdomain.com  # ← CHANGE THIS

# ── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=246516248223-75obk25p5b79gvudl0q2i9n1kjme2eba.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=246516248223-75obk25p5b79gvudl0q2i9n1kjme2eba.apps.googleusercontent.com

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=shotx
POSTGRES_DB=shotx
POSTGRES_PASSWORD=ChangeMe_StrongPassword_Here    # ← CHANGE THIS
# DATABASE_URL สร้างอัตโนมัติใน docker-compose จาก 3 ค่าข้างบน

# ── JWT ───────────────────────────────────────────────────────
# สร้างด้วย:  openssl rand -hex 64
JWT_SECRET=replace_with_output_of_openssl_rand_hex_64  # ← CHANGE THIS

# ── EC2 Local Storage ─────────────────────────────────────────
STORAGE_DIR=/var/www/shotx/uploads
STORAGE_PUBLIC_URL=https://api.shotx.yourdomain.com/uploads  # ← CHANGE THIS

# ── InsightFace (AI worker) ───────────────────────────────────
INSIGHTFACE_MODEL=buffalo_l

# ── App ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
