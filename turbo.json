{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"],
      "passThroughEnv": [
        "REDIS_URL",
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "AWS_REGION",
        "AWS_ENDPOINT_URL",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "S3_FORCE_PATH_STYLE"
      ]
    },
    "synth": {
      "cache": false,
      "outputs": ["cdk.out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
