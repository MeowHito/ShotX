# ShotX environment variables. Copy to .env for local development; never commit .env.
# Values below target `docker compose up` (PostgreSQL, Redis, LocalStack). On AWS the ECS task
# definitions in infra/ set these from stack resources. No real secrets belong in this file.

# --- Runtime ---------------------------------------------------------------------------------
NODE_ENV=development
APP_STAGE=local
# Public origins. On AWS: https://<domain.main> and https://<domain.admin> from infra/cdk.json.
PUBLIC_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
# web and admin call the API server-side here. On AWS: the internal ALB (stack output ApiInternalUrl).
API_INTERNAL_URL=http://localhost:4000
# PORT is set per service on AWS (web/admin 3000, api 4000); locally each app uses its own default.

# --- AWS / LocalStack ------------------------------------------------------------------------
AWS_REGION=ap-southeast-1
# LocalStack only. On AWS remove these: tasks use their IAM role and the real endpoints. On the
# VPS never set AWS_ENDPOINT_URL (the Rekognition and SES loaders refuse it there): AWS SDK v3
# applies it to every client, so storage, Rekognition and SES have their own STORAGE_*,
# REKOGNITION_* and SES_* settings (ADR 0008 section 1). The same goes for every
# AWS_ENDPOINT_URL_<SERVICE> (e.g. _REKOGNITION, _SES, _SESV2). On the VPS the production compose
# sets AWS_IGNORE_CONFIGURED_ENDPOINT_URLS=true on api and worker, and the Rekognition and SES
# loaders require it off AWS outside APP_STAGE=local. Never set it locally (LocalStack SQS
# needs AWS_ENDPOINT_URL).
# AWS_IGNORE_CONFIGURED_ENDPOINT_URLS=true
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_FORCE_PATH_STYLE=true
# Required by localstack/localstack 2026.03 and later (docker compose passes it through).
# Get one at https://app.localstack.cloud. The free Hobby plan is for non-commercial use only.
LOCALSTACK_AUTH_TOKEN=
# Override the LocalStack image if needed.
# LOCALSTACK_IMAGE=localstack/localstack:2026.10

# --- PostgreSQL ------------------------------------------------------------------------------
DATABASE_URL=postgres://shotx:shotx@localhost:5432/shotx
# Created by the compose init script from template1, so ltree is already installed.
TEST_DATABASE_URL=postgres://shotx:shotx@localhost:5432/shotx_test
# On AWS there is no DATABASE_URL. Tasks get the libpq variables instead, which node-postgres
# reads when no connection string is given: PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD,
# PGSSLMODE=verify-full (images must ship the RDS CA bundle, see NODE_EXTRA_CA_CERTS).
# PGHOST=
# PGPORT=5432
# PGDATABASE=shotx
# PGUSER=
# PGPASSWORD=
# PGSSLMODE=verify-full
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/rds-global-bundle.pem

# --- Redis -----------------------------------------------------------------------------------
# Cache, rate limits, short-lived grants and the shared Rekognition rate limiter (api + worker).
# On AWS: rediss://<ElastiCache primary endpoint>:6379 (TLS), never with credentials in the URL.
REDIS_URL=redis://localhost:6379
# ElastiCache RBAC user (the default user is disabled). On AWS both come from Secrets Manager as
# ECS secrets (stack output RedisSecretArn). Local Redis has no AUTH: leave them empty.
# Connect with e.g. new Redis(REDIS_URL, { username: REDIS_USERNAME, password: REDIS_PASSWORD }).
REDIS_USERNAME=
REDIS_PASSWORD=
# VPS compose only (ADR 0008): allow REDIS_USERNAME/PASSWORD over plain redis:// when the host is
# private (a compose service name such as `redis`, localhost or a private IP). Never on AWS.
REDIS_ALLOW_PLAINTEXT_AUTH=false

# --- Storage and queues ----------------------------------------------------------------------
# Created by infra/local/localstack/init-aws.sh. On AWS: stack outputs of ShotX-<stage>-App.
MEDIA_BUCKET=shotx-local-media
# Media storage endpoint (packages/shared/src/config/storage.ts, api, worker, web). Set: the S3
# clients get this endpoint, region and keys explicitly (never AWS_ENDPOINT_URL or the default
# credential chain). Unset (AWS stacks): AWS S3 through AWS_REGION and the task role, as before.
# Outside APP_STAGE=local it must be https on a public host. Locally: LocalStack, path-style.
STORAGE_ENDPOINT_URL=http://localhost:4566
STORAGE_REGION=ap-southeast-1
STORAGE_ACCESS_KEY_ID=test
STORAGE_SECRET_ACCESS_KEY=test
# Storage class of originals: INTELLIGENT_TIERING (default, AWS) | STANDARD | STANDARD_IA. R2
# accepts only STANDARD and STANDARD_IA (the loader refuses INTELLIGENT_TIERING on R2).
STORAGE_ORIGINALS_CLASS=STANDARD
# Cloudflare R2 (VPS, ADR 0008 section 2): one private bucket, no r2.dev URL, no custom domain;
# an R2 API token per service (api, worker; never the backup token). Path-style keeps uploads and
# media on one origin for the CSP.
# MEDIA_BUCKET=shotx-prod-media
# STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY_ID=<R2 API token access key id>
# STORAGE_SECRET_ACCESS_KEY=<R2 API token secret>
# STORAGE_ORIGINALS_CLASS=STANDARD
# S3_FORCE_PATH_STYLE=true
# MEDIA_URL_SIGNER=s3-presign
# Optional: a separate R2 token with Object Read only, used just to sign GET URLs (a presigned
# URL embeds its access key id). Unset = the api's STORAGE_* keys sign.
# STORAGE_SIGNING_ACCESS_KEY_ID=<read-only R2 token access key id>
# STORAGE_SIGNING_SECRET_ACCESS_KEY=<read-only R2 token secret>
# Bucket lifecycle and CORS (lifecycle.ts; deploy/r2 applies them). Defaults equal infra/cdk.json
# storage.*: abort incomplete multipart 2 days (>= 2), tmp/zips/ 2, tmp/reconcile/ 3, tmp/ 3
# (1-3, the catch-all at least the others), CORS max age 3000 s.
# STORAGE_ABORT_INCOMPLETE_MULTIPART_UPLOAD_DAYS=2
# STORAGE_TMP_ZIPS_EXPIRATION_DAYS=2
# STORAGE_TMP_RECONCILE_EXPIRATION_DAYS=3
# STORAGE_TMP_OTHER_EXPIRATION_DAYS=3
# STORAGE_UPLOAD_CORS_MAX_AGE_SECONDS=3000
MEDIA_QUEUE_URL=http://localhost:4566/queue/ap-southeast-1/000000000000/shotx-local-media
FACES_QUEUE_URL=http://localhost:4566/queue/ap-southeast-1/000000000000/shotx-local-faces
ZIP_QUEUE_URL=http://localhost:4566/queue/ap-southeast-1/000000000000/shotx-local-zip
# EventBridge Scheduler messages: {"type": "<job type>", "scheduledTime": "<ISO-8601>"}.
JOBS_QUEUE_URL=http://localhost:4566/queue/ap-southeast-1/000000000000/shotx-local-jobs
# worker: each queue's visibility timeout (infra/cdk.json queues.<name>.visibilityTimeoutSeconds).
# Every job heartbeats with ChangeMessageVisibility every third of it until the job ends, so the
# timeout is how fast a crashed worker's message comes back, not how long a job may run
# (infra/README.md, "Queue visibility and heartbeats").
MEDIA_QUEUE_VISIBILITY_TIMEOUT_SECONDS=300
FACES_QUEUE_VISIBILITY_TIMEOUT_SECONDS=900
ZIP_QUEUE_VISIBILITY_TIMEOUT_SECONDS=300
JOBS_QUEUE_VISIBILITY_TIMEOUT_SECONDS=900

# --- Queue backend (packages/shared/src/config/queues.ts, api and worker) --------------------
# sqs (default; AWS and LocalStack, the *_QUEUE_URL above) or bullmq (BullMQ on REDIS_URL, ADR
# 0008). With bullmq the queue URLs are not read and keys live under shotx:<APP_STAGE>:bull
# (BullMQ `prefix`). Local uploads need sqs until the api enqueues the media job on upload complete
# (ADR 0008 step 2): with bullmq nothing processes a new upload yet, since LocalStack's S3 event
# goes to the SQS media queue.
QUEUE_BACKEND=sqs
# api: give up on one enqueue after this many ms (Redis or SQS unreachable) and fail the request.
QUEUE_ENQUEUE_TIMEOUT_MS=5000
# BullMQ per queue (validated with either backend). Code defaults: attempts = infra/cdk.json
# maxReceiveCount, lock duration = the visibility timeout, backoff base x 2^(attempt-1). Failed jobs
# (the DLQ: 14 days) and completed jobs (1 day) are kept up to a count and an age, the event stream
# up to a length: BullMQ keys have no TTL.
MEDIA_QUEUE_ATTEMPTS=5
MEDIA_QUEUE_BACKOFF_BASE_SECONDS=10
MEDIA_QUEUE_LOCK_DURATION_SECONDS=300
MEDIA_QUEUE_MAX_STALLED_COUNT=1
MEDIA_QUEUE_FAILED_RETENTION_COUNT=10000
MEDIA_QUEUE_COMPLETED_RETENTION_COUNT=1000
MEDIA_QUEUE_COMPLETED_RETENTION_SECONDS=86400
MEDIA_QUEUE_FAILED_RETENTION_SECONDS=1209600
MEDIA_QUEUE_EVENTS_MAX_LEN=10000
FACES_QUEUE_ATTEMPTS=5
FACES_QUEUE_BACKOFF_BASE_SECONDS=10
FACES_QUEUE_LOCK_DURATION_SECONDS=900
FACES_QUEUE_MAX_STALLED_COUNT=1
FACES_QUEUE_FAILED_RETENTION_COUNT=10000
FACES_QUEUE_COMPLETED_RETENTION_COUNT=1000
FACES_QUEUE_COMPLETED_RETENTION_SECONDS=86400
FACES_QUEUE_FAILED_RETENTION_SECONDS=1209600
FACES_QUEUE_EVENTS_MAX_LEN=10000
ZIP_QUEUE_ATTEMPTS=3
ZIP_QUEUE_BACKOFF_BASE_SECONDS=10
ZIP_QUEUE_LOCK_DURATION_SECONDS=300
ZIP_QUEUE_MAX_STALLED_COUNT=1
ZIP_QUEUE_FAILED_RETENTION_COUNT=10000
ZIP_QUEUE_COMPLETED_RETENTION_COUNT=1000
ZIP_QUEUE_COMPLETED_RETENTION_SECONDS=86400
ZIP_QUEUE_FAILED_RETENTION_SECONDS=1209600
ZIP_QUEUE_EVENTS_MAX_LEN=10000
JOBS_QUEUE_ATTEMPTS=3
JOBS_QUEUE_BACKOFF_BASE_SECONDS=10
JOBS_QUEUE_LOCK_DURATION_SECONDS=900
JOBS_QUEUE_MAX_STALLED_COUNT=1
JOBS_QUEUE_FAILED_RETENTION_COUNT=10000
JOBS_QUEUE_COMPLETED_RETENTION_COUNT=1000
JOBS_QUEUE_COMPLETED_RETENTION_SECONDS=86400
JOBS_QUEUE_FAILED_RETENTION_SECONDS=1209600
JOBS_QUEUE_EVENTS_MAX_LEN=10000

# --- Scheduled jobs on BullMQ (packages/shared/src/config/schedules.ts, worker) -------------
# Five-field cron (cron-parser syntax) in SCHEDULE_TIMEZONE. Defaults equal infra/cdk.json
# `schedules` (EventBridge on AWS). The cron lines stay commented here because their spaces
# would need quotes, which `source .env` and env-file parsers treat differently; quote them when
# you set one. Set *_ENABLED=false to remove a job's scheduler.
SCHEDULE_TIMEZONE=Asia/Bangkok
# SCHEDULE_STATS_ROLLUP_HOURLY_CRON=5 * * * *
SCHEDULE_STATS_ROLLUP_HOURLY_ENABLED=true
# SCHEDULE_SUBSCRIPTIONS_TRANSITION_DAILY_CRON=0 1 * * *
SCHEDULE_SUBSCRIPTIONS_TRANSITION_DAILY_ENABLED=true
# SCHEDULE_TRASH_PURGE_DAILY_CRON=30 1 * * *
SCHEDULE_TRASH_PURGE_DAILY_ENABLED=true
# SCHEDULE_FACES_EXPIRE_DAILY_CRON=0 2 * * *
SCHEDULE_FACES_EXPIRE_DAILY_ENABLED=true
# SCHEDULE_FACES_RECONCILE_DAILY_CRON=30 4 * * *
SCHEDULE_FACES_RECONCILE_DAILY_ENABLED=true
# SCHEDULE_QUOTA_RECONCILE_NIGHTLY_CRON=30 3 * * *
SCHEDULE_QUOTA_RECONCILE_NIGHTLY_ENABLED=true
# ADR 0008 "Lost jobs": re-send lost media and faces work, and purge expired refresh sessions.
# SCHEDULE_MEDIA_SWEEP_CRON=7,22,37,52 * * * *
SCHEDULE_MEDIA_SWEEP_ENABLED=true
# SCHEDULE_FACES_SWEEP_CRON=20 * * * *
SCHEDULE_FACES_SWEEP_ENABLED=true
# SCHEDULE_AUTH_SESSIONS_PURGE_DAILY_CRON=0 5 * * *
SCHEDULE_AUTH_SESSIONS_PURGE_DAILY_ENABLED=true

# --- CloudFront signed URLs (api, MEDIA_URL_SIGNER=cloudfront) -------------------------------
# On AWS: https://<domain.main>/media
CLOUDFRONT_MEDIA_BASE_URL=
# CloudFront public key id (stack output CloudfrontKeyPairId).
CLOUDFRONT_KEY_PAIR_ID=
# RSA private key (PEM). On AWS it comes from Secrets Manager. Never commit a real key.
CLOUDFRONT_PRIVATE_KEY=

# --- Local development stand-ins (packages/shared/src/config/local-dev.ts, auth.ts) ---------
# AUTH_PROVIDER=local is refused anywhere but APP_STAGE=local with a non-production NODE_ENV. On
# AWS remove both (the defaults are cognito and cloudfront).
# cognito | shotx | local. local = the API's own tokens (shotx) plus a dev sign-in with any email
# (POST /auth/dev/login, users pool only). See "API-issued sign-in" below.
AUTH_PROVIDER=local
# cloudfront (default, AWS) | s3-presign (storage.ts): SigV4 presigned GETs on
# STORAGE_ENDPOINT_URL signed with the STORAGE_* keys, on any stage (R2 on the VPS, LocalStack
# here). Never an unsigned or non-expiring media URL; the bucket is never public.
MEDIA_URL_SIGNER=s3-presign

# --- API-issued sign-in (packages/shared/src/config/auth.ts; AUTH_PROVIDER=shotx or local) ---
# web, admin and api: AUTH_BFF_KEY, the shared key the BFFs send in x-shotx-bff-key (at least 32
# characters). Its local value is in the placeholder block below.
# api: Ed25519 signing key per pool (EdDSA), AUTH_USERS_SIGNING_KEY and AUTH_ADMINS_SIGNING_KEY
# (placeholder block below), as PKCS#8 PEM or the base64 of its DER:
#   openssl genpkey -algorithm ed25519 -outform DER | base64
AUTH_USERS_SIGNING_KEY_ID=users-1
AUTH_ADMINS_SIGNING_KEY_ID=admins-1
# Rotation: the old key's public half and kid stay accepted while old tokens live
#   (openssl pkey -in old.pem -pubout -outform DER | base64).
# AUTH_USERS_PREVIOUS_PUBLIC_KEY=
# AUTH_USERS_PREVIOUS_KEY_ID=
# AUTH_ADMINS_PREVIOUS_PUBLIC_KEY=
# AUTH_ADMINS_PREVIOUS_KEY_ID=
# Code defaults: 15 min access tokens; refresh families of 30 days (users) and 12 h (admins).
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_USERS_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_ADMINS_REFRESH_TOKEN_TTL_SECONDS=43200
AUTH_LOGIN_STATE_TTL_SECONDS=600
AUTH_LOGIN_RATE_PER_IP=30
AUTH_LOGIN_RATE_PER_IP_WINDOW_SECONDS=600
# Timeout of each call to LINE or Google (token endpoint, JWKS, verify).
AUTH_OIDC_HTTP_TIMEOUT_MS=10000
# A just-rotated refresh token presented again within this window gets the same successor instead
# of REFRESH_TOKEN_REUSED (racing tabs, retried requests). 0 = off.
AUTH_REFRESH_REUSE_GRACE_SECONDS=10
# web and admin: timeout of each call to the API's /auth/* routes.
AUTH_CLIENT_TIMEOUT_MS=15000
# LINE Login channel and Google OAuth client. Required with shotx; with local each provider is
# offered only when both of its values are set.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Admins: ADMIN_TOTP_ENCRYPTION_KEY (placeholder block below) is the AES-256-GCM key of the stored
# TOTP secrets (openssl rand -base64 32). Required with shotx; with local, admin sign-in is on
# only when it and AUTH_ADMINS_SIGNING_KEY are set.
ADMIN_TOTP_PERIOD_SECONDS=30
ADMIN_TOTP_DIGITS=6
ADMIN_TOTP_WINDOW=1
ADMIN_MFA_CHALLENGE_TTL_SECONDS=300
# An unconfirmed TOTP enrolment (created by the operator CLI) must be confirmed by a first sign-in
# within this; after it the CLI's reset-totp is needed. Default 7 days.
ADMIN_TOTP_ENROLMENT_TTL_SECONDS=604800
ADMIN_PASSWORD_MIN_LENGTH=14
ADMIN_LOGIN_RATE_PER_ACCOUNT=5
ADMIN_LOGIN_RATE_PER_ACCOUNT_WINDOW_SECONDS=900
ADMIN_LOGIN_RATE_PER_IP=20
ADMIN_LOGIN_RATE_PER_IP_WINDOW_SECONDS=900
ADMIN_LOGIN_LOCKOUT_THRESHOLD=10
ADMIN_LOGIN_LOCKOUT_SECONDS=900

# --- Local-only placeholder secrets (APP_STAGE=local ONLY) -----------------------------------
# These values are public (they are in this file). The loaders refuse them on every stage but
# APP_STAGE=local (SHA-256 fingerprints in packages/shared/src/config/example-secrets.ts). For any
# shared or deployed environment generate your own:
#   AUTH_BFF_KEY:              openssl rand -base64 48
#   AUTH_ADMIN_BFF_KEY:        openssl rand -base64 48 (a different value; the admin app's key)
#   AUTH_*_SIGNING_KEY:        openssl genpkey -algorithm ed25519 -outform DER | base64
#   ADMIN_TOTP_ENCRYPTION_KEY: openssl rand -base64 32
AUTH_BFF_KEY=local-dev-only-bff-key-change-me-0123456789
AUTH_ADMIN_BFF_KEY=local-dev-only-admin-bff-key-change-me-0123456789
AUTH_USERS_SIGNING_KEY=MC4CAQAwBQYDK2VwBCIEIE1MiSq/6AnkUHBgBtrkmVcuwaQDl1HH4Wr1e2CBZGpQ
AUTH_ADMINS_SIGNING_KEY=MC4CAQAwBQYDK2VwBCIEIJr5dpkaEytRGVMO/aNZB2zqxIWJzIwIhp5Of80R863A
ADMIN_TOTP_ENCRYPTION_KEY=bG9jYWwtZGV2LW9ubHktdG90cC1rZXktMzJieXRlcyE=

# --- Cognito (AUTH_PROVIDER=cognito) ---------------------------------------------------------
# Users pool (photographers and viewers; Google and LINE sign-in). Identity provider names: Google, LINE.
COGNITO_USER_POOL_ID=
COGNITO_WEB_CLIENT_ID=
# e.g. https://<prefix>.auth.ap-southeast-1.amazoncognito.com
COGNITO_DOMAIN=
# Admins pool (MFA required).
COGNITO_ADMIN_USER_POOL_ID=
COGNITO_ADMIN_CLIENT_ID=
COGNITO_ADMIN_DOMAIN=

# --- AWS WAF CAPTCHA (web: face search) ------------------------------------------------------
# Created after deploy in the WAF console (application integration, us-east-1).
WAF_CAPTCHA_API_KEY=
WAF_CAPTCHA_SCRIPT_URL=

# --- Captcha after a rate-limit hit (packages/shared/src/config/captcha.ts; api and web) -----
# ADR 0008 section 7: on the VPS Cloudflare Turnstile replaces the WAF CAPTCHA on face search and
# face deletion, shown only after a FACE_SEARCH_RATE_* hit (RATE_LIMITED details.captcha), never
# on every scan. waf (default; AWS stacks, refused off AWS outside local) | turnstile | none
# (refused on APP_STAGE=prod). The CSP then allows https://challenges.cloudflare.com in
# script-src and frame-src. Commented here: unset keeps today's behaviour locally.
# CAPTCHA_PROVIDER=turnstile
# web: public site key. api: secret key (never sent to browsers). Locally Cloudflare's test keys
# work (always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA);
# they are refused outside APP_STAGE=local.
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# api: siteverify timeout, and what a solved challenge buys (code defaults; load-test them):
# 5 more requests within 10 minutes for that share, viewer and IP; at most 10 grants per IP per hour.
# TURNSTILE_VERIFY_TIMEOUT_MS=5000
# CAPTCHA_GRANT_ATTEMPTS=5
# CAPTCHA_GRANT_TTL_SECONDS=600
# CAPTCHA_GRANTS_PER_IP=10
# CAPTCHA_GRANTS_PER_IP_WINDOW_SECONDS=3600

# --- Error reporting -------------------------------------------------------------------------
# Face-search request bodies must be excluded from Sentry and all logs.
SENTRY_DSN=

# --- Face recognition (packages/shared/src/config/face.ts) -----------------------------------
# ADR 0009: self-hosted by default. ONNX models in the api and worker processes, vectors in
# Postgres (pgvector, docker compose builds deploy/postgres-image). Fetch the models first:
#   pnpm face-models            (YuNet + SFace into .models/face, checked by SHA-256)
# FACE_MODEL_DIR is relative to the app's working directory (apps/api, apps/worker).
FACE_PROVIDER=self-hosted
FACE_DETECTOR_MODEL=yunet-2023mar
FACE_MODEL=sface-2021dec
FACE_MODEL_DIR=../../.models/face
FACE_DETECTOR_MIN_SCORE=0.8
FACE_DETECTOR_NMS_IOU=0.3
FACE_DETECTOR_LONG_EDGE=1920
FACE_DETECTOR_WINDOW_OVERLAP=0.2
FACE_MIN_FACE_PX=32
FACE_ONNX_THREADS=2
FACE_INFERENCE_CONCURRENCY=2
FACE_INFERENCE_MAX_WAIT_MS=5000
FACE_HNSW_EF_SEARCH=100
FACE_HNSW_MAX_SCAN_TUPLES=20000
# Images above this many pixels are refused before decoding (anonymous selfies stay bounded).
FACE_DECODE_MAX_PIXELS=40000000
# Rekognition client (FACE_PROVIDER=rekognition only) (aws-clients.ts, api and worker), explicit per ADR 0008 section 1:
# REKOGNITION_REGION (else AWS_REGION, else ap-southeast-1); REKOGNITION_ENDPOINT_URL only for
# tests and LocalStack (outside APP_STAGE=local only an https AWS host); keys required off AWS
# (AUTH_PROVIDER=shotx/local or STORAGE_ENDPOINT_URL set), unset on AWS (task role). Locally:
# LocalStack, as AWS_ENDPOINT_URL did before.
REKOGNITION_REGION=ap-southeast-1
REKOGNITION_ENDPOINT_URL=http://localhost:4566
REKOGNITION_ACCESS_KEY_ID=test
REKOGNITION_SECRET_ACCESS_KEY=test
# VPS: an IAM user limited to Rekognition on collection/pg-* (ADR 0008 section 6); no endpoint.
# REKOGNITION_ACCESS_KEY_ID=<IAM user access key id>
# REKOGNITION_SECRET_ACCESS_KEY=<IAM user secret>
# Thresholds: empty = the default of FACE_PROVIDER / FACE_MODEL (SFace 50 / 36, Rekognition
# 95 / 85; FACE_DELETION_THRESHOLD follows FACE_STRONG). Set them only for the model they were
# measured on: the face PoC decides the real ones per model.
FACE_STRONG=
FACE_MAYBE=
FACE_MAX_SELFIES=3
FACE_EXPANSION_SEEDS=2
FACE_SEARCH_MAX_FACES=1000
FACE_SEARCH_QUALITY_FILTER=AUTO
FACE_SELFIE_LONG_EDGE=1280
FACE_SELFIE_JPEG_QUALITY=90
FACE_INDEX_LONG_EDGE=3500
FACE_INDEX_JPEG_QUALITY=90
# IndexFaces images and tiles go to Rekognition as Image.Bytes (ADR 0008 section 5): at most
# 5 MiB (5242880, the default and the ceiling). Nothing is written to tmp/index/ any more.
FACE_INDEX_MAX_BYTES=5242880
FACE_INDEX_MAX_FACES=100
FACE_INDEX_QUALITY_FILTER=LOW
# never | signal | always: when to also index overlapping tiles.
FACE_INDEX_TILING=signal
FACE_TILE_GRID=2
FACE_TILE_OVERLAP=0.15
FACE_TILE_EDGE_EPSILON=0.01
FACE_SMALL_FACE_RATIO=0.02
FACE_DEDUPE_IOU=0.5
# Orphan reconciliation (faces.reconcile.daily) deletes a face without a `faces` row only after
# this long, and an indexing attempt must commit its rows within half of it. It must be at least
# twice the longest faces attempt: 2 x 3960 s with the retry settings below (infra checks this at
# synth). Default 10800000 (3 h).
FACE_ORPHAN_GRACE_MS=10800000
FACE_ENCODE_QUALITY_STEP=5
FACE_ENCODE_MIN_QUALITY=60
FACE_ENCODE_SHRINK_FACTOR=0.85
FACE_ENCODE_MIN_LONG_EDGE=320
# Rekognition rate limits, one shared Redis bucket per operation (api and worker must agree).
# 5 is a placeholder: before launch set each to ~80% of the account's ap-southeast-1 quota.
FACE_REKOGNITION_TPS_INDEX_FACES=5
FACE_REKOGNITION_TPS_SEARCH_FACES_BY_IMAGE=5
FACE_REKOGNITION_TPS_SEARCH_FACES=5
FACE_REKOGNITION_TPS_DELETE_FACES=5
# ListFaces (orphan reconciliation only) has its own quota.
FACE_REKOGNITION_TPS_LIST_FACES=5
FACE_REKOGNITION_TPS_COLLECTION=5
# TPS values are whole numbers from 1 to 1000. Burst is in (0, 1]: an idle bucket lets
# max(1, floor(tps x burst)) calls start at once; 1 allows the whole second's quota at once.
FACE_REKOGNITION_BURST_SECONDS=1
FACE_REKOGNITION_RATE_LIMIT_PREFIX=shotx:rekognition
# SDK request timeout for one Rekognition HTTP request (both profiles). The worker must set it on
# its Rekognition client; infra's faces worst case counts it once per attempt.
FACE_REKOGNITION_REQUEST_TIMEOUT_MS=10000
# Worker profile.
FACE_REKOGNITION_MAX_ATTEMPTS=8
FACE_REKOGNITION_RETRY_BASE_MS=200
FACE_REKOGNITION_RETRY_MAX_MS=10000
FACE_REKOGNITION_MAX_WAIT_MS=30000
# Interactive profile (api face search).
FACE_REKOGNITION_INTERACTIVE_MAX_ATTEMPTS=3
FACE_REKOGNITION_INTERACTIVE_RETRY_BASE_MS=100
FACE_REKOGNITION_INTERACTIVE_RETRY_MAX_MS=1000
FACE_REKOGNITION_INTERACTIVE_MAX_WAIT_MS=2000
# api: face-search requests (any number of selfies) allowed per window, per IP, share and viewer.
FACE_SEARCH_RATE_PER_IP=10
FACE_SEARCH_RATE_PER_IP_WINDOW_SECONDS=600
FACE_SEARCH_RATE_PER_SHARE=1200
FACE_SEARCH_RATE_PER_SHARE_WINDOW_SECONDS=600
FACE_SEARCH_RATE_PER_VIEWER=10
FACE_SEARCH_RATE_PER_VIEWER_WINDOW_SECONDS=600
# api: face-search upload limits. On AWS infra derives them from FACE_MAX_SELFIES and
# FACE_SELFIE_LONG_EDGE (infra/lib/face-limits.ts) and the WAF enforces the same body limit.
# Values below are those defaults: min(5 MiB, 1280² × 3) per selfie; 3 selfies + 64 KiB.
FACE_SEARCH_MAX_SELFIE_BYTES=4915200
FACE_SEARCH_MAX_BODY_BYTES=14811136
# api: "ขอลบใบหน้าของฉัน" deletes direct matches at or above this similarity (>= FACE_MAYBE).
FACE_DELETION_THRESHOLD=
# api (ADR 0007): when one share records this many face deletions within the window, the api logs
# the structured line {"event": "face_deletion.alert", ...}; infra alarms on it.
FACE_DELETION_ALERT_PER_SHARE=20
FACE_DELETION_ALERT_WINDOW_SECONDS=86400

# --- Features and consent (packages/shared/src/config/features.ts, consent.ts) ---------------
# api and worker. Off until a real-event Phase 0 evaluation passes. Locally, true works with the
# self-hosted provider once `pnpm face-models` has run (the api and worker refuse to start with
# FACE_SEARCH_ENABLED=true and missing models). On AWS: infra/cdk.json features.faceSearchEnabled.
FACE_SEARCH_ENABLED=false
# api: consent text version viewers must accept (one of CONSENT_POLICY_VERSIONS in
# packages/shared); it must name FACE_PROVIDER's processor (2026-10-25 Rekognition, 2026-10-29
# our own servers). Unset: the newest for FACE_PROVIDER. On AWS: infra/cdk.json consent.policyVersion.
CONSENT_POLICY_VERSION=2026-10-29
# api: HMAC key of consents.ip_hash, at least 32 characters. Local placeholder only; on AWS it is a
# generated Secrets Manager secret (stack output IpHashSecretArn) passed as an ECS secret.
IP_HASH_SECRET=local-dev-only-ip-hash-secret-not-for-aws

# --- Sharing and downloads (packages/shared/src/config/share.ts) -----------------------------
# Values are the code defaults (assumptions; load-test before launch). On AWS set overrides in
# infra/cdk.json services.env.backend so api and worker agree.
SIGNED_URL_VIEW_TTL_SECONDS=3600
SIGNED_URL_DOWNLOAD_TTL_SECONDS=600
# Signed URL expiries are rounded up to a multiple of this (<= the download TTL).
SIGNED_URL_EXPIRY_BUCKET_SECONDS=300
SHARE_PAGE_SIZE=100
SHARE_FACE_ONLY_GRANT_TTL_SECONDS=86400
SHARE_UNLOCK_TTL_SECONDS=86400
ANON_ID_MAX_AGE_DAYS=365
VIEWER_SESSION_TTL_SECONDS=43200
ZIP_MAX_FILES=500
ZIP_MAX_BYTES=2147483648
# How long a finished zip can be downloaded (at most 2 days). infra keeps tmp/zips/ objects longer
# than this plus the worker's zip cap and the download URL lifetime (storage.tmpZipsExpirationDays,
# at most 3 days, checked at synth).
ZIP_RESULT_TTL_SECONDS=86400
SHARE_UNLOCK_RATE_PER_IP=10
SHARE_UNLOCK_RATE_PER_IP_WINDOW_SECONDS=900
SHARE_DOWNLOAD_RATE_PER_VIEWER=300
SHARE_DOWNLOAD_RATE_PER_VIEWER_WINDOW_SECONDS=600
ZIP_CREATE_RATE_PER_VIEWER=10
ZIP_CREATE_RATE_PER_VIEWER_WINDOW_SECONDS=3600
SHARE_FEEDBACK_RATE_PER_VIEWER=100
SHARE_FEEDBACK_RATE_PER_VIEWER_WINDOW_SECONDS=600

# --- Share passwords (packages/shared/src/config/password.ts, api) ---------------------------
# argon2id parameters for new share password hashes (code defaults; OWASP minimum m=19456 KiB at
# t=2). The api verifies any stored hash whose parameters meet the OWASP minimums.
SHARE_PASSWORD_ARGON2_MEMORY_KIB=19456
SHARE_PASSWORD_ARGON2_TIME_COST=2
SHARE_PASSWORD_ARGON2_PARALLELISM=1

# --- Retention (packages/shared/src/config/retention.ts, api and worker) ---------------------
# Code defaults. The DPO or legal team reviews these before launch.
TRASH_RETENTION_DAYS=30
FACE_INDEX_EXPIRY_DAYS=90
SUBSCRIPTION_GRACE_DAYS=14
# 30-60 days after expiry the account's S3 objects and Rekognition collection are deleted.
SUBSCRIPTION_PURGE_AFTER_EXPIRY_DAYS=45
SUBSCRIPTION_REMINDER_DAYS=14,7,1
# The purge warning email goes out this many days before the purge (< the purge delay).
SUBSCRIPTION_PURGE_WARNING_DAYS=7
# auth.sessions.purge.daily deletes refresh sessions this many days after they expire.
AUTH_SESSION_RETENTION_DAYS=7

# --- Billing (packages/shared/src/config/billing.ts, api and worker) -------------------------
# Code defaults. Plan prices and quotas live in the `plans` table, not here.
BILLING_PREPAID_MONTHS=1,3,6,12
VAT_RATE_BASIS_POINTS=700
EGRESS_ANOMALY_MULTIPLIER=20
EGRESS_ANOMALY_MIN_BYTES=10737418240
BILLING_CHECKOUT_EXPIRY_SECONDS=900
BILLING_MIN_CHARGE_SATANG=2000
BILLING_PRORATION_DAYS_PER_MONTH=30
BILLING_RENEWAL_MAX_ATTEMPTS=3
BILLING_RENEWAL_LEAD_SECONDS=86400
# fake | omise | 2c2p. fake is refused when NODE_ENV=production. On AWS: infra/cdk.json
# Read only when BILLING_MODE=gateway (ADR 0010); offline mode reads no PAYMENT_* setting.
# billing.paymentGateway; the secrets below come from Secrets Manager as ECS secrets (stack output
# PaymentGatewaySecretArn), only those of the selected gateway.
PAYMENT_GATEWAY=fake
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
# fake gateway: HMAC key of the x-fake-signature webhook header (at least 16 characters). Local
# placeholder only.
PAYMENT_FAKE_WEBHOOK_SECRET=local-dev-only-fake-webhook-secret
# omise (Opn Payments). Never commit real keys.
# PAYMENT_OMISE_PUBLIC_KEY=
# PAYMENT_OMISE_SECRET_KEY=
# PAYMENT_OMISE_WEBHOOK_SECRET=
# 2c2p.
# PAYMENT_2C2P_MERCHANT_ID=
# PAYMENT_2C2P_SECRET_KEY=

# --- Email (packages/shared/src/config/billing.ts, api and worker) ---------------------------
# ses | fake. fake records messages and is refused when NODE_ENV=production. On AWS: infra/cdk.json
# email.provider, email.fromAddress (an SES domain identity infra creates) and email.fromName.
EMAIL_PROVIDER=fake
EMAIL_FROM_ADDRESS=no-reply@shotx.test
EMAIL_FROM_NAME=ShotX
# SES client with EMAIL_PROVIDER=ses (aws-clients.ts), like Rekognition: SES_REGION (else
# AWS_REGION, else ap-southeast-1), SES_ENDPOINT_URL (tests/LocalStack only), keys required off
# AWS. Locally LocalStack (unused while EMAIL_PROVIDER=fake).
SES_REGION=ap-southeast-1
SES_ENDPOINT_URL=http://localhost:4566
SES_ACCESS_KEY_ID=test
SES_SECRET_ACCESS_KEY=test
# VPS: an IAM user limited to SES sending; no endpoint.
# SES_ACCESS_KEY_ID=<IAM user access key id>
# SES_SECRET_ACCESS_KEY=<IAM user secret>

# --- Uploads and drive (packages/shared/src/config/upload.ts, drive.ts) ----------------------
# web (Uppy) and api must agree: on AWS set UPLOAD_* overrides in services.env.common only.
UPLOAD_MAX_IMAGE_BYTES=104857600
UPLOAD_MAX_VIDEO_BYTES=5368709120
UPLOAD_PART_BYTES=16777216
UPLOAD_PRESIGN_TTL_SECONDS=3600
UPLOAD_PART_CONCURRENCY=4
UPLOAD_SESSION_TTL_SECONDS=86400
UPLOAD_INIT_PRESIGNED_PARTS=8
DRIVE_PAGE_SIZE=100
DRIVE_MAX_FOLDER_DEPTH=32
# Wave 7 studio (api; code defaults, assumptions): page sizes of GET /drive/recent and
# GET /drive/search, the most items one search returns over all its pages, copies per
# photographer per window, and owner folder zips queued or running at once per photographer.
DRIVE_RECENT_PAGE_SIZE=50
DRIVE_SEARCH_PAGE_SIZE=50
DRIVE_SEARCH_MAX_RESULTS=1000
DRIVE_COPY_RATE_PER_USER=120
DRIVE_COPY_RATE_WINDOW_SECONDS=60
DRIVE_ZIP_MAX_ACTIVE_JOBS=3

# --- Client IP (packages/shared/src/config/proxy.ts, api) ---------------------------------
# The reverse proxy's own address(es), whose X-Forwarded-For the API trusts (ADR 0008 section 1),
# comma-separated, or `none`. Empty or blank = unset = none (local: no proxy). Required with
# AUTH_PROVIDER=shotx outside APP_STAGE=local, where `none` must be written out. Single addresses only, never a range: the API treats requests from the
# proxy as internet traffic and ignores the BFF key and x-shotx-client-ip on them, so the compose
# network range (e.g. 172.18.0.0/16) would also cover web and admin and break every /auth/* call.
# On the VPS give the proxy container a fixed address on the compose network (ipv4_address) and
# list just that, e.g. 172.18.0.2. Calls from web and admin carry the client IP in
# x-shotx-client-ip, trusted only with a valid AUTH_BFF_KEY.
TRUSTED_PROXY_ADDRESSES=

# --- API request limits (packages/shared/src/config/api.ts) ----------------------------------
API_JSON_BODY_MAX_BYTES=65536
UPLOAD_COMPLETE_BODY_MAX_BYTES=1048576
UPLOAD_INIT_RATE_PER_USER=600
UPLOAD_INIT_RATE_WINDOW_SECONDS=60

# --- Worker (packages/shared/src/config/worker.ts) -------------------------------------------
# Code defaults. Messages per receive and processed at once per task, per queue.
WORKER_MEDIA_BATCH_SIZE=4
WORKER_MEDIA_CONCURRENCY=2
WORKER_FACES_BATCH_SIZE=4
WORKER_FACES_CONCURRENCY=2
WORKER_ZIP_BATCH_SIZE=1
WORKER_ZIP_CONCURRENCY=1
WORKER_JOBS_BATCH_SIZE=1
WORKER_JOBS_CONCURRENCY=1
WORKER_RECEIVE_WAIT_SECONDS=20
WORKER_RETRY_BASE_SECONDS=10
# On AWS the ECS stop timeout is this plus services.worker.stopTimeoutMarginSeconds (<= 120 s).
WORKER_SHUTDOWN_GRACE_SECONDS=20
# Per-message caps. infra checks the faces cap against its faces worst case (3960 s), the zip cap
# against ZIP_MAX_BYTES at queues.zip.jobBudget throughput, and every cap against queue retention.
WORKER_MEDIA_MAX_PROCESSING_SECONDS=14400
WORKER_FACES_MAX_PROCESSING_SECONDS=7200
WORKER_ZIP_MAX_PROCESSING_SECONDS=7200
WORKER_JOB_MAX_RUNTIME_SECONDS=21600
WORKER_JOB_BATCH_SIZE=200
WORKER_JOB_DEDUPE_TTL_SECONDS=604800
WORKER_EXIF_DEFAULT_UTC_OFFSET=+07:00
# Binaries on PATH by default (the worker image ships them; CI installs ffmpeg).
# WORKER_FFMPEG_PATH=ffmpeg
# WORKER_FFPROBE_PATH=ffprobe
WORKER_VIDEO_X264_PRESET=veryfast
WORKER_VIDEO_AUDIO_BITRATE_KBPS=128
# Scratch directory for originals, video output and zips; unset = the OS temporary directory.
# WORKER_TMP_DIR=
LOG_LEVEL=info
# Sweeps (ADR 0008 "Lost jobs"; contracts at SCHEDULED_JOB_TYPES in packages/shared). Ages are
# longer than the matching WORKER_*_MAX_PROCESSING_SECONDS, so running jobs aren't duplicated.
MEDIA_SWEEP_PROCESSING_AGE_SECONDS=21600
MEDIA_SWEEP_UPLOADING_AGE_SECONDS=3600
MEDIA_SWEEP_MAX_REQUEUES=3
MEDIA_SWEEP_BATCH_SIZE=500
FACES_SWEEP_DELETION_AGE_SECONDS=3600
FACES_SWEEP_INDEX_AGE_SECONDS=21600
FACES_SWEEP_MAX_REQUEUES=3
FACES_SWEEP_BATCH_SIZE=500
AUTH_SESSIONS_PURGE_BATCH_SIZE=1000

# --- Cost estimates in USD (packages/shared/src/config/cost.ts) ------------------------------
S3_STANDARD_GB_MONTH=0.025
REKOGNITION_CALL=0.001
REKOGNITION_FACE_MONTH=0.00001
CLOUDFRONT_PLAN_MONTH=200
USD_THB=33

# --- Accounts and billing mode (ADR 0010; shared config/billing.ts, upload.ts, auth.ts, admin-console.ts)
BILLING_MODE=offline
STORAGE_QUOTA_ENFORCED=false
ADMIN_LIST_PAGE_SIZE=50
PHOTOGRAPHER_PASSWORD_MIN_LENGTH=10
PHOTOGRAPHER_LOGIN_RATE_PER_ACCOUNT=5
PHOTOGRAPHER_LOGIN_RATE_PER_ACCOUNT_WINDOW_SECONDS=900
PHOTOGRAPHER_LOGIN_RATE_PER_IP=20
PHOTOGRAPHER_LOGIN_RATE_PER_IP_WINDOW_SECONDS=900
PHOTOGRAPHER_LOGIN_LOCKOUT_THRESHOLD=10
PHOTOGRAPHER_LOGIN_LOCKOUT_SECONDS=900
PHOTOGRAPHER_PASSWORD_CHANGE_SESSION_TTL_SECONDS=1800
# apps/admin: length of the initial passwords its "generate" button makes (16–128)
ADMIN_GENERATED_PASSWORD_LENGTH=20
