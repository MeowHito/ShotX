# ShotX environment variables. Copy to .env for local development; never commit .env.
# Values below target `docker compose up` (PostgreSQL, Redis, LocalStack). On AWS the ECS task
# definitions in infra/ set these from stack resources. No real secrets belong in this file.

# --- Runtime ---------------------------------------------------------------------------------
NODE_ENV=development
APP_STAGE=local
# Public origins. On AWS: https://<domain.main> and https://<domain.admin> from infra/cdk.json.
PUBLIC_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
# web and admin call the API server-side here. On AWS: the internal ALB (stack output ApiInternalUrl).
API_INTERNAL_URL=http://localhost:4000
# PORT is set per service on AWS (web/admin 3000, api 4000); locally each app uses its own default.

# --- AWS / LocalStack ------------------------------------------------------------------------
AWS_REGION=ap-southeast-1
# LocalStack only. On AWS remove these: tasks use their IAM role and the real endpoints.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_FORCE_PATH_STYLE=true
# Required by localstack/localstack 2026.03 and later (docker compose passes it through).
# Get one at https://app.localstack.cloud. The free Hobby plan is for non-commercial use only.
LOCALSTACK_AUTH_TOKEN=
# Override the LocalStack image if needed.
# LOCALSTACK_IMAGE=localstack/localstack:2026.10

# --- PostgreSQL ------------------------------------------------------------------------------
DATABASE_URL=postgres://shotx:shotx@localhost:5432/shotx
# Created by the compose init script from template1, so ltree is already installed.
TEST_DATABASE_URL=postgres://shotx:shotx@localhost:5432/shotx_test
# On AWS there is no DATABASE_URL. Tasks get the libpq variables instead, which node-postgres
# reads when no connection string is given: PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD,
# PGSSLMODE=verify-full (images must ship the RDS CA bundle, see NODE_EXTRA_CA_CERTS).
# PGHOST=
# PGPORT=5432
# PGDATABASE=shotx
# PGUSER=
# PGPASSWORD=
# PGSSLMODE=verify-full
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/rds-global-bundle.pem

# --- Redis -----------------------------------------------------------------------------------
# Cache, rate limits, short-lived grants and the shared Rekognition rate limiter (api + worker).
# On AWS: rediss://<ElastiCache primary endpoint>:6379 (TLS).
REDIS_URL=redis://localhost:6379

# --- Storage and queues ----------------------------------------------------------------------
# Created by infra/local/localstack/init-aws.sh. On AWS: stack outputs of ShotX-<stage>-App.
MEDIA_BUCKET=shotx-local-media
MEDIA_QUEUE_URL=http://localhost:4566/queue/ap-southeast-1/000000000000/shotx-local-media
FACES_QUEUE_URL=http://localhost:4566/queue/ap-southeast-1/000000000000/shotx-local-faces
ZIP_QUEUE_URL=http://localhost:4566/queue/ap-southeast-1/000000000000/shotx-local-zip
# EventBridge Scheduler messages: {"type": "<job type>", "scheduledTime": "<ISO-8601>"}.
JOBS_QUEUE_URL=http://localhost:4566/queue/ap-southeast-1/000000000000/shotx-local-jobs

# --- CloudFront signed URLs (api) ------------------------------------------------------------
# On AWS: https://<domain.main>/media
CLOUDFRONT_MEDIA_BASE_URL=
# CloudFront public key id (stack output CloudfrontKeyPairId).
CLOUDFRONT_KEY_PAIR_ID=
# RSA private key (PEM). On AWS it comes from Secrets Manager. Never commit a real key.
CLOUDFRONT_PRIVATE_KEY=

# --- Cognito ---------------------------------------------------------------------------------
# Users pool (photographers and viewers; Google and LINE sign-in). Identity provider names: Google, LINE.
COGNITO_USER_POOL_ID=
COGNITO_WEB_CLIENT_ID=
# e.g. https://<prefix>.auth.ap-southeast-1.amazoncognito.com
COGNITO_DOMAIN=
# Admins pool (MFA required).
COGNITO_ADMIN_USER_POOL_ID=
COGNITO_ADMIN_CLIENT_ID=
COGNITO_ADMIN_DOMAIN=

# --- AWS WAF CAPTCHA (web: face search) ------------------------------------------------------
# Created after deploy in the WAF console (application integration, us-east-1).
WAF_CAPTCHA_API_KEY=
WAF_CAPTCHA_SCRIPT_URL=

# --- Error reporting -------------------------------------------------------------------------
# Face-search request bodies must be excluded from Sentry and all logs.
SENTRY_DSN=

# --- Face recognition (packages/shared/src/config/face.ts) -----------------------------------
# Values are the code defaults. The face PoC decides the real thresholds.
FACE_STRONG=95
FACE_MAYBE=85
FACE_MAX_SELFIES=3
FACE_EXPANSION_SEEDS=2
FACE_SEARCH_MAX_FACES=1000
FACE_SEARCH_QUALITY_FILTER=AUTO
FACE_SELFIE_LONG_EDGE=1280
FACE_SELFIE_JPEG_QUALITY=90
FACE_INDEX_LONG_EDGE=3500
FACE_INDEX_JPEG_QUALITY=90
FACE_INDEX_MAX_BYTES=15728640
FACE_INDEX_MAX_FACES=100
FACE_INDEX_QUALITY_FILTER=LOW
FACE_TILE_GRID=2
FACE_TILE_OVERLAP=0.15
FACE_TILE_EDGE_EPSILON=0.01
FACE_SMALL_FACE_RATIO=0.02
FACE_DEDUPE_IOU=0.5
FACE_ENCODE_QUALITY_STEP=5
FACE_ENCODE_MIN_QUALITY=60
FACE_ENCODE_SHRINK_FACTOR=0.85
FACE_ENCODE_MIN_LONG_EDGE=320
# Rekognition rate limits, one shared Redis bucket per operation (api and worker must agree).
# 5 is a placeholder: before launch set each to ~80% of the account's ap-southeast-1 quota.
FACE_REKOGNITION_TPS_INDEX_FACES=5
FACE_REKOGNITION_TPS_SEARCH_FACES_BY_IMAGE=5
FACE_REKOGNITION_TPS_SEARCH_FACES=5
FACE_REKOGNITION_TPS_DELETE_FACES=5
FACE_REKOGNITION_TPS_COLLECTION=5
FACE_REKOGNITION_BURST_SECONDS=1
FACE_REKOGNITION_RATE_LIMIT_PREFIX=shotx:rekognition
# Worker profile.
FACE_REKOGNITION_MAX_ATTEMPTS=8
FACE_REKOGNITION_RETRY_BASE_MS=200
FACE_REKOGNITION_RETRY_MAX_MS=10000
FACE_REKOGNITION_MAX_WAIT_MS=30000
# Interactive profile (api face search).
FACE_REKOGNITION_INTERACTIVE_MAX_ATTEMPTS=3
FACE_REKOGNITION_INTERACTIVE_RETRY_BASE_MS=100
FACE_REKOGNITION_INTERACTIVE_RETRY_MAX_MS=1000
FACE_REKOGNITION_INTERACTIVE_MAX_WAIT_MS=2000

# --- Cost estimates in USD (packages/shared/src/config/cost.ts) ------------------------------
S3_STANDARD_GB_MONTH=0.025
REKOGNITION_CALL=0.001
REKOGNITION_FACE_MONTH=0.00001
CLOUDFRONT_PLAN_MONTH=200
USD_THB=33
